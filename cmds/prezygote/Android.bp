cc_binary {
    name: "prezygote",

    srcs: [ "prezygote.cpp" ],
    shared_libs: [ "libbase" ],

    cflags: [
        "-Wextra",
    ],
    compile_multilib: "both",
    multilib: {
        lib32: {
            suffix: "32",
        },
        lib64: {
            suffix: "64",
        },
    },
}
