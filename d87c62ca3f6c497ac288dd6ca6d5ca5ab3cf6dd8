        "id": 1015428
      },
      "writtenOn": "2020-02-02T03:17:10Z",
      "side": 1,
      "message": "Because the administrator uids must contain the owner UID I don\u0027t think you need to check this at all. If you think it\u0027s unclear a comment is fine.",
      "revId": "d87c62ca3f6c497ac288dd6ca6d5ca5ab3cf6dd8",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": true
