    {
      "unresolved": true,
      "key": {
        "uuid": "3995e9ec_bf4075fa",
        "filename": "/PATCHSET_LEVEL",
        "patchSetId": 2
      },
      "lineNbr": 0,
      "author": {
        "id": 1941946
