bluetooth tethering is ready to use.\n            }\n        }\n    }\n    \n    @Override\n    public void onError(@NonNull TetheringInterface iface, @TetheringIfaceError int error) {\n        if (iface.getType() \u003d\u003d TetheringManager.TETHERING_BLUETOOTH) {\n            // tethering is fail because of @TetheringIfaceError error. \n        }\n    }\n}",
