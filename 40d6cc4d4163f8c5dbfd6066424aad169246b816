      "writtenOn": "2019-02-22T14:15:29Z",
      "side": 1,
      "message": "Do we must keep tracking all the apps?\n\nCan we \n 1. query the list from PackageManager when needed? Or\n 2. use (the uid ranges - system uids - vpn app) as our list?",
      "range": {
        "startLine": 89,
        "startChar": 31,
        "endLine": 89,
        "endChar": 39
      },
      "revId": "40d6cc4d4163f8c5dbfd6066424aad169246b816",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
