        "id": 1308504
      },
      "writtenOn": "2019-03-14T08:32:57Z",
      "side": 1,
      "message": "No we should not reset mNeedReRunProvisioningUi. Consider below use case:\n1. User enable usb tethering with UI entitlement check and tethering upstream is wifi. Thus there are no entitlement check lunch at this time.\n2. User enable hotspot with non-UI entitlement check.\n3. tethering upstream is switched from wifi to mobile.\n4. re-run UI entitlement check is needed for this case.",
      "parentUuid": "81b53ad5_ee896de2",
      "range": {
        "startLine": 210,
        "startChar": 16,
        "endLine": 210,
        "endChar": 42
      },
      "revId": "5f2ae7f86ea6ed34055229e2f0c7f9f04012d75a",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": false
    },
