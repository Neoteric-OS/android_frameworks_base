      "lineNbr": 290,
      "author": {
        "id": 1015428
      },
      "writtenOn": "2019-03-14T09:04:56Z",
      "side": 1,
      "message": "So the point is that if size() \u003e 1, then we are already doing it, so don\u0027t run it again ? If that\u0027s the thinking I think it warrants a comment",
      "range": {
        "startLine": 290,
        "startChar": 43,
        "endLine": 290,
        "endChar": 46
      },
      "revId": "5f2ae7f86ea6ed34055229e2f0c7f9f04012d75a",
