      "writtenOn": "2019-04-19T15:59:43Z",
      "side": 1,
      "message": "Wifi supports 6 keepalives on most devices. This only applies to the currently connected network and there is only 1 wifi network active currently.",
      "parentUuid": "f239f19d_4351552c",
