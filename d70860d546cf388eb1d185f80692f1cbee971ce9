    {
      "key": {
        "uuid": "3adea709_d986a76e",
        "filename": "services/core/java/com/android/server/connectivity/Vpn.java",
        "patchSetId": 8
      },
      "lineNbr": 2609,
      "author": {
        "id": 1015428
      },
      "writtenOn": "2020-03-30T09:55:42Z",
      "side": 1,
      "message": "In a modern language this doesn\u0027t build because your mutable field can have changed between these two accesses. Any such code should always put the mutable member inside an immutable local.\n\nNote that this doesn\u0027t even *work*. exitVpnRunner is called in mObserver.interfaceStatusChanged, which is called in-situ in response to a broadcast of CONNECTIVITY_ACTION. Net result : the thread calling this is under no obligation to observe the write resulting from the call to setThread, mThread is null, and you never stop the thread. Of course making the field final fixes the issue forever, courtesy of Java 17.5.\n\nNo seriously. Make your fields final. Human brains are not smart enough to get mutability right.",
      "range": {
        "startLine": 2609,
        "startChar": 0,
        "endLine": 2609,
        "endChar": 53
      },
