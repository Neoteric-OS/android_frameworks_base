      },
      "writtenOn": "2024-11-22T19:24:55Z",
      "side": 1,
      "message": "(Marking it unresolved in case it gets lost after my comments)",
      "parentUuid": "428ca7c1_433c22c2",
      "revId": "137d9e60f363e71a14ae732d8312153a642053ba",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
