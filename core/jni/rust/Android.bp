package {
    default_applicable_licenses: ["frameworks_base_core_jni_license"],
}

rust_proc_macro {
    name: "libjni_platform_macros",
    crate_name: "jni_platform_macros",
    crate_root: "jni_platform_macros/src/lib.rs",
    edition: "2021",
    rustlibs: [
        "libproc_macro2",
        "libquote",
        "libsyn",
    ],
}

rust_test_host {
    name: "jni_platform_macros_test",
    crate_name: "jni_platform_macros",
    crate_root: "jni_platform_macros/src/lib.rs",
    edition: "2021",
    test_suites: ["general-tests"],
    auto_gen_config: true,
    rustlibs: [
        "libproc_macro2",
        "libquote",
        "libsyn",
    ],
}

rust_library {
    name: "libjni_support",
    crate_name: "jni_support",
    crate_root: "jni_support/src/lib.rs",
    edition: "2021",
    host_supported: true,
    rustlibs: [
        "libjni_next",
        "libthiserror",
    ],
}

rust_test_host {
    name: "jni_support_test",
    crate_name: "jni_support",
    crate_root: "jni_support/src/lib.rs",
    edition: "2021",
    test_suites: ["general-tests"],
    auto_gen_config: true,
    rustlibs: [
        "libjni_next",
        "libthiserror",
    ],
    proc_macros: ["libjni_platform_macros"],
}

rust_test_host {
    name: "jni_shim_abi_test",
    crate_name: "generated_shim_abi",
    crate_root: "jni_support/tests/generated_shim_abi.rs",
    edition: "2021",
    test_suites: ["general-tests"],
    auto_gen_config: true,
    rustlibs: [
        "libjni_support",
        "libjni_next",
    ],
    proc_macros: ["libjni_platform_macros"],
}

rust_defaults {
    name: "libandroid_runtime_rs_defaults",
    crate_name: "android_runtime",
    crate_root: "src/lib.rs",
    edition: "2021",
    rustlibs: [
        "libjni_support",
        "libatrace_rust",
        "libcxx",
        "libjni_next",
        "liblibc",
        "liblog_buffer",
        "liblog_event_list",
        "liblog_reader",
        "liblog_rust",
        "liblogger",
        "librustutils",
        "libtracing_perfetto_rust",
    ],
    proc_macros: ["libjni_platform_macros"],
}

rust_ffi_static {
    name: "libandroid_runtime_rs",
    defaults: ["libandroid_runtime_rs_defaults"],
    host_supported: true,
}

rust_test_host {
    name: "android_runtime_rs_test",
    defaults: ["libandroid_runtime_rs_defaults"],
    test_suites: ["general-tests"],
    auto_gen_config: true,
}
