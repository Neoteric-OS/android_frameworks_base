package {
    default_applicable_licenses: ["frameworks_base_core_jni_license"],
}

rust_proc_macro {
    name: "libjni_macros",
    crate_name: "jni_macros",
    crate_root: "jni_macros/src/lib.rs",
    edition: "2021",
    rustlibs: [
        "libproc_macro2",
        "libquote",
        "libsyn",
    ],
}

rust_test_host {
    name: "jni_macros_test",
    crate_name: "jni_macros",
    crate_root: "jni_macros/src/lib.rs",
    edition: "2021",
    test_suites: ["general-tests"],
    auto_gen_config: true,
    rustlibs: [
        "libproc_macro2",
        "libquote",
        "libsyn",
    ],
}

rust_library {
    name: "libjni_support",
    crate_name: "jni_support",
    crate_root: "jni_support/src/lib.rs",
    edition: "2021",
    host_supported: true,
    rustlibs: [
        "libjni",
        "libthiserror",
    ],
}

rust_test_host {
    name: "jni_support_test",
    crate_name: "jni_support",
    crate_root: "jni_support/src/lib.rs",
    edition: "2021",
    test_suites: ["general-tests"],
    auto_gen_config: true,
    rustlibs: [
        "libjni",
        "libthiserror",
    ],
    proc_macros: ["libjni_macros"],
}

// Generate the C++ side of the cxx bridge declared in
// src/sysprop_change.rs.
genrule {
    name: "libandroid_runtime_rs_bridge_header",
    tools: ["cxxbridge"],
    cmd: "$(location cxxbridge) $(in) --header > $(out)",
    srcs: ["src/sysprop_change.rs"],
    out: ["sysprop_change.rs.h"],
}

genrule {
    name: "libandroid_runtime_rs_bridge_code",
    tools: ["cxxbridge"],
    cmd: "$(location cxxbridge) $(in) > $(out)",
    srcs: ["src/sysprop_change.rs"],
    out: ["sysprop_change.rs.cpp"],
}

// Generate the C++ side of the cxx bridge declared in
// src/input_event_ffi.rs.
genrule {
    name: "libandroid_runtime_rs_bridge_input_event_header",
    tools: ["cxxbridge"],
    cmd: "$(location cxxbridge) $(in) --header > $(out)",
    srcs: ["src/input_event_ffi.rs"],
    out: ["input_event_ffi.rs.h"],
}

genrule {
    name: "libandroid_runtime_rs_bridge_input_event_code",
    tools: ["cxxbridge"],
    cmd: "$(location cxxbridge) $(in) > $(out)",
    srcs: ["src/input_event_ffi.rs"],
    out: ["input_event_ffi.rs.cpp"],
}

// Generate the C++ side of the cxx bridge declared in
// src/motion_event_ffi.rs.
genrule {
    name: "libandroid_runtime_rs_bridge_motion_event_header",
    tools: ["cxxbridge"],
    cmd: "$(location cxxbridge) $(in) --header > $(out)",
    srcs: ["src/motion_event_ffi.rs"],
    out: ["motion_event_ffi.rs.h"],
}

genrule {
    name: "libandroid_runtime_rs_bridge_motion_event_code",
    tools: ["cxxbridge"],
    cmd: "$(location cxxbridge) $(in) > $(out)",
    srcs: ["src/motion_event_ffi.rs"],
    out: ["motion_event_ffi.rs.cpp"],
}

// The C++ half of android_runtime's cxx bridges: the generated bridge code
// plus the handwritten libutils/libinput glue it declares.
cc_library_static {
    name: "libandroid_runtime_rs_bridge",
    host_supported: true,
    srcs: [
        "ffi/input_event.cpp",
        "ffi/motion_event.cpp",
        "ffi/motion_event_parcel.cpp",
        "ffi/sysprop_change.cpp",
    ],
    // input_event_compat.h declares the #[repr(C)] bundles that cross the
    // Rust boundary by layout; the permanent facades in core/jni (e.g.
    // android_view_KeyEvent.cpp) include it through this export.
    export_include_dirs: ["ffi"],
    generated_headers: [
        "cxx-bridge-header",
        "libandroid_runtime_rs_bridge_header",
        "libandroid_runtime_rs_bridge_input_event_header",
        "libandroid_runtime_rs_bridge_motion_event_header",
    ],
    generated_sources: [
        "libandroid_runtime_rs_bridge_code",
        "libandroid_runtime_rs_bridge_input_event_code",
        "libandroid_runtime_rs_bridge_motion_event_code",
    ],
    shared_libs: ["libutils"],
    // libinput, linked the same way libandroid_runtime links it: shared on
    // device, static on host.
    target: {
        android: {
            shared_libs: ["libinput"],
        },
        host: {
            static_libs: ["libinput"],
        },
    },
}

rust_defaults {
    name: "libandroid_runtime_rs_defaults",
    crate_name: "android_runtime",
    crate_root: "src/lib.rs",
    edition: "2021",
    rustlibs: [
        "libjni_support",
        "libatrace_rust",
        "libcxx",
        "libjni",
        "liblibc",
        "liblog_buffer",
        "liblog_event_list",
        "liblog_reader",
        "liblog_rust",
        "liblogger",
        "librustutils",
        "libtracing_perfetto_rust",
    ],
    proc_macros: ["libjni_macros"],
    // The crate's own cxx bridge (src/sysprop_change.rs). libandroid_runtime
    // must also list it in static_libs, since Soong does not propagate it
    // through rust_ffi_static; see core/jni/Android.bp.
    static_libs: ["libandroid_runtime_rs_bridge"],
    // Host builds resolve __system_property_* from libbase's fallback
    // implementation (on device they come from bionic's libc); see
    // src/android_os_system_properties.rs.
    shared_libs: ["libbase"],
    // The input-event bridge calls android::MotionEvent/KeyEvent (libinput);
    // linkage matches libandroid_runtime's: shared on device, static on host.
    // Needed here (not only on the bridge) because cc_library_static deps do
    // not propagate into the rust_test link. Host uses the shared libinput:
    // the static archive carries UBSan-minimal instrumentation whose runtime
    // rust_test links don't provide, while the .so is self-contained (and
    // brings libbinder/libui-types along).
    target: {
        android: {
            shared_libs: ["libinput"],
        },
        host: {
            shared_libs: [
                "libbinder",
                "libinput",
            ],
        },
    },
}

// Rust implementations of libandroid_runtime's JNI methods, linked into
// libandroid_runtime via whole_static_libs.
rust_ffi_static {
    name: "libandroid_runtime_rs",
    defaults: ["libandroid_runtime_rs_defaults"],
    host_supported: true,
}

rust_test_host {
    name: "android_runtime_rs_test",
    defaults: ["libandroid_runtime_rs_defaults"],
    test_suites: ["general-tests"],
    auto_gen_config: true,
}

rust_test_host {
    name: "jni_shim_abi_test",
    crate_name: "generated_shim_abi",
    crate_root: "jni_support/tests/generated_shim_abi.rs",
    edition: "2021",
    test_suites: ["general-tests"],
    auto_gen_config: true,
    rustlibs: [
        "libjni_support",
        "libjni",
    ],
    proc_macros: ["libjni_macros"],
}
