package: "android.net.flags"

# This file contains aconfig flags used from platform code
# Flags used in Connectivity module must be in aconfig files under packages/modules/Connectivity

flag {
  name: "ipsec_transform_state"
  namespace: "android_core_networking_ipsec"
  description: "The flag controls the access for getIpSecTransformState and IpSecTransformState"
  bug: "308011229"
}
