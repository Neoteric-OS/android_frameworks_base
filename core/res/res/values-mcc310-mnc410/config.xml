<!-- These resources are around just to allow their values to be customized
     for different hardware and product builds. -->

<!-- SystemUI-related features for AT&T -->
<resources>
    <!-- Identify operator by name (att, tmo, etc.,)             -->
    <!--   to customize networkType and related features.        -->
    <string name="config_operator_name">att</string>

    <!-- Do not display roaming icon when device is roaming (AT&T). -->
    <bool name="config_no_roaming_icon">true</bool>

    <!-- Display roaming icon when roaming and there is no data connection on tablet (AT&T). -->
    <bool name="config_show_roaming_icon_when_roaming_but_no_data">false</bool>

</resources>
