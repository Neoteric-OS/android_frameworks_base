<resources>
  <!-- The trustworthiness of the attestation depends on the root
    certificate of the chain. Android devices that have passed the
    testing required to have the Google suite of apps, including Google Play,
    and which launched with Android 7.0 (API level 24) or higher should use
    attestation keys signed by the Google Hardware Attestation Root certificate.
    This PEM-encoded certificate is used for verifying attestations.

    These certificates are retrieved from:
    https://developer.android.com/training/articles/security-key-attestation#root_certificate.

    Please add vendor_required_attestation_keys.xml (matching this file) in
    vendor overlay with <item></item> of the GMS PEM-encoded root certificates,
    if not already in Google Overlay.
  -->
    <string-array translatable="false" name="vendor_required_attestation_keys">
    </string-array>
</resources>
