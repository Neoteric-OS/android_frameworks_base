<!-- This is default SignalLevel config file for non-specified products. -->

<SignalLevelFile NumberOfBars="4"
                 NumberOfSignalEntries="5" >

    <!-- GsmAsuLevel
     ASU ranges from 0 to 31 - TS 27.007 Sec 8.5
     asu = 0 (-113dB or less) is very weak
     signal, its better to show 0 bars to the user in such cases.
     asu = 99 is a special case, where the signal strength is unknown
     -->
    <SignalLevelInfo RadioType = "GSM"
                     SignalBars="4"
                     AsuLevel="3,5,8,12" />

    <SignalLevelInfo RadioType = "UMTS"
                     SignalBars="4"
                     AsuLevel="3,5,8,12"
                     RscpLevel="-105,-100,-90,-80"
                     EcnoLevel="-15,-13,-11,-9" />

    <SignalLevelInfo RadioType = "CDMA"
                     SignalBars="4"
                     DbmLevel="-100,-95,-85,-75"
                     EcioLevel="-150,-130,-110,-90" />

    <!-- for cdma Evdo, it could use attribute "EcioLevel" to replace "SnrLevel" -->
    <SignalLevelInfo RadioType = "EVDO"
                     SignalBars="4"
                     DbmLevel="-105,-90,-75,-65"
                     SnrLevel="1,3,5,7" />

    <!-- RssiLevel
      Valid values are (0-63, 99) as defined in TS 36.331
     -->
    <!-- RsrpLevel
      TS 36.214 Physical Layer Section 5.1.3 TS 36.331 RRC RSSI = received
      signal + noise RSRP = reference signal dBm RSRQ = quality of signal
      dB= Number of Resource blocksxRSRP/RSSI SNR = gain=signal/noise ratio
      = -10log P1/P2 dB
    -->
    <!-- SnrLevel
      Values are -200 dB to +300 (SNR*10dB) RS_SNR >= 13.0 dB =>4 bars 4.5
      dB <= RS_SNR < 13.0 dB => 3 bars 1.0 dB <= RS_SNR < 4.5 dB => 2 bars
      -3.0 dB <= RS_SNR < 1.0 dB 1 bar RS_SNR < -3.0 dB/No Service Antenna
      Icon Only
     -->
    <SignalLevelInfo RadioType = "LTE"
                     SignalBars="4"
                     RssiLevel="0,5,8,12"
                     RsrpLevel="-115,-105,-95,-85"
                     SnrLevel="-30,10,45,130" />
</SignalLevelFile>


