module: "android.sysprop.WallpaperProperties"
owner: Platform

prop {
    api_name: "wallpaper_path"
    type: String
    prop_name: "wallpaper.config.default.path"
    scope: Public
    access: Readonly
    legacy_prop_name: "ro.config.wallpaper"
}

prop {
    api_name: "lock_wallpaper_path"
    type: String
    prop_name: "wallpaper.config.lock.path"
    scope: Public
    access: Readonly
    legacy_prop_name: "ro.config.lock_wallpaper"
}

prop {
    api_name: "live_wallpaper_component"
    type: String
    prop_name: "wallpaper.config.live.component"
    scope: Public
    access: Readonly
    legacy_prop_name: "ro.config.wallpaper_component"
}
