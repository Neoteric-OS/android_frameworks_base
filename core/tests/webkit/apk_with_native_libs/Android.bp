java_defaults {
    name: "webkit.apk_with_native_libs",
    srcs: ["src/**/*.java"],
    sdk_version: "system_current",
    compile_multilib: "both",
    optimize: {
        enabled: false,
    },
    jni_libs: ["libwebviewtest_jni"],
}

// Builds an apk containing native libraries that will be unzipped on the device.
android_test_helper_app {
    name: "WebViewLoadingOnDiskTestApk",
    manifest: "ondisk/AndroidManifest.xml",
    defaults: ["webkit.apk_with_native_libs"],
    test_suites: ["device-tests"],
}

// Builds an apk containing uncompressed native libraries that have to be
// accessed through the APK itself on the device.
android_test_helper_app {
    name: "WebViewLoadingFromApkTestApk",
    manifest: "inapk/AndroidManifest.xml",
    defaults: ["webkit.apk_with_native_libs"],
    test_suites: ["device-tests"],
}
