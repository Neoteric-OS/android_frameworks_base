android_test {
    name: "SmartCamera",

    optimize: {
        enabled: false,
    },

    // comment it out for now since we need use some hidden APIs
    sdk_version: "current",

    static_libs: ["android-ex-camera2"],

    srcs: [
        "src/**/*.java",
        "<func:'all-renderscript-files-under' unset>",
    ],

    jni_libs: ["libsmartcamera_jni"],

}

