      "writtenOn": "2022-02-03T06:53:33Z",
      "side": 1,
      "message": "for this and the ones below, is it enough to keep public methods and fields? or do native call private methods?",
      "revId": "748375b074e60e7e8f3be6c9081f502350e20b0f",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
