        "patchSetId": 1
      },
      "lineNbr": 32,
      "author": {
        "id": 1022895
      },
      "writtenOn": "2015-11-07T04:56:42Z",
      "side": 1,
      "message": "Done",
      "parentUuid": "568ea242_1f0a89a5",
      "revId": "9ff20929e841a9514e6917db7ad1f3527ecd69a6",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": false
    },
    {
      "key": {
        "uuid": "f6923665_b9bfd27c",
        "filename": "core/java/android/security/net/config/XmlConfigSource.java",
