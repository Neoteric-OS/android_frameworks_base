      "author": {
        "id": 1022895
      },
      "writtenOn": "2015-11-07T04:56:42Z",
      "side": 1,
      "message": "The fields aren\u0027t set until parsing succeeds.",
      "parentUuid": "36892e3b_4fd1c4d5",
      "revId": "9ff20929e841a9514e6917db7ad1f3527ecd69a6",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": false
