      "author": {
        "id": 1018773
      },
      "writtenOn": "2015-11-07T04:14:33Z",
      "side": 1,
      "message": "Style: There\u0027s usually no need to assign false or null -- these are the default values. You assigning these two fields makes me wonder why you\u0027re not assigning other fields. So, this is slower to read as a result.",
      "revId": "9ff20929e841a9514e6917db7ad1f3527ecd69a6",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": false
    },
