    {
      "key": {
        "uuid": "cb93d8d7_bb54e874",
        "filename": "core/java/android/net/ConnectivityManager.java",
        "patchSetId": 6
      },
      "lineNbr": 2197,
      "author": {
        "id": 1080048
      },
      "writtenOn": "2017-03-28T20:36:21Z",
      "side": 1,
      "message": "I kind of prefer when functions like this are phrased as a question rather than like \"carrierAllowsCellularTethering\". For \"isCellularTetheringAllowed\", I\u0027d like for it to be clear that it\u0027s a question to the carrier. Would you prefer \"isCellularTetheringAllowedByCarrier\"? I\u0027m not sure that\u0027s any better than the current name, but if there\u0027s some API naming convention I\u0027m missing, I\u0027m happy to change this.",
      "parentUuid": "54ec7e37_6a56c5a9",
      "range": {
        "startLine": 2197,
        "startChar": 16,
        "endLine": 2197,
        "endChar": 41
      },
      "revId": "8e683cbe4630ef204ce14e69713519a39f86eb77",
