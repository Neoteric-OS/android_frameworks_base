        "id": 1003259
      },
      "writtenOn": "2021-06-29T12:45:45Z",
      "side": 1,
      "message": "I think there is enough information in \"Audio Sink\", \"Audio Source\" and \"Wearable Audio Device\" types and subtypes to map to either HEADSET or SPEAKER.\nIf this info can be trusted from the BT LE accessory...",
      "parentUuid": "c1462a6c_c30120d2",
      "range": {
        "startLine": 457,
        "startChar": 28,
        "endLine": 457,
        "endChar": 50
      },
      "revId": "08c06e6da29c0b225003546befcb2d9e698fd96d",
