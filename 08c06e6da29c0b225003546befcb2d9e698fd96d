      "message": "https://specificationrefs.bluetooth.com/assigned-values/Appearance%20Values.pdf",
      "parentUuid": "9485072f_82d46749",
      "range": {
        "startLine": 457,
        "startChar": 28,
        "endLine": 457,
        "endChar": 50
      },
      "revId": "08c06e6da29c0b225003546befcb2d9e698fd96d",
