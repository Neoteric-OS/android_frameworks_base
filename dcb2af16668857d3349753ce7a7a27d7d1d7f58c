      "writtenOn": "2021-01-20T11:57:47Z",
      "side": 1,
      "message": "I don\u0027t think we want a new synchronous API. We\u0027ve been trying to move everybody out of it for a long time. If they don\u0027t want to be blamed, let them use the asynchronous APIs.",
      "range": {
        "startLine": 24879,
        "startChar": 0,
        "endLine": 24879,
        "endChar": 215
      },
      "revId": "dcb2af16668857d3349753ce7a7a27d7d1d7f58c",
