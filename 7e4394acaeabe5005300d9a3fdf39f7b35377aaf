    {
      "key": {
        "uuid": "057aad98_305caf9f",
        "filename": "core/java/android/net/LinkProperties.java",
        "patchSetId": 4
      },
      "lineNbr": 1233,
      "author": {
        "id": 1015428
      },
      "writtenOn": "2019-03-14T05:51:02Z",
      "side": 1,
      "message": "I\u0027m not necessarily opposed to this, but because we don\u0027t have such a test right now we know for a fact this is never used with a non-null argument. Why then not just keep it non-null ? While I see the usefulness of passing null to this, I\u0027m not sure it\u0027s actually more valuable than the non-nullity.\n\nCan you justify why this is a good change ? What was your reasoning ?",
      "range": {
        "startLine": 1231,
        "startChar": 9,
        "endLine": 1233,
        "endChar": 9
      },
      "revId": "7e4394acaeabe5005300d9a3fdf39f7b35377aaf",
