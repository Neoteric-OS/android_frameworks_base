        "id": 1304263
      },
      "writtenOn": "2019-01-23T06:03:50Z",
      "side": 1,
      "message": "Not necessary in this commit if we would like to update it.\n\nWe may use try {} final {} to make sure it works as expectation. Like: \nhttps://cs.corp.google.com/aosp-lollipop/packages/providers/TelephonyProvider/src/com/android/providers/telephony/MmsSmsProvider.java?q\u003dMmsSmsProvider\u0026dr\u003dCSs\u0026l\u003d533\n\nHow about your thought?",
      "range": {
        "startLine": 492,
        "startChar": 8,
        "endLine": 492,
        "endChar": 23
      },
      "revId": "10c1a6789d65a399f19023906e737826cdaa9156",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
