    {
      "key": {
        "uuid": "afd153fa_33819704",
        "filename": "services/core/java/com/android/server/IpSecService.java",
        "patchSetId": 2
      },
      "lineNbr": 254,
      "author": {
        "id": 1015428
      },
      "writtenOn": "2019-03-11T14:26:23Z",
      "side": 1,
      "message": "So let me get this straight :\nThis is a reference counted resource that increments their refcount by being added to a parent, and decrements them when a parent is fully released. But it can also be released by the user, and *that\u0027s* when it frees its resources. Well some of them, the ones in invalidate().\n\nIs there any way to make this simpler and closer to what we usually call a \"reference counted\" object ? Or to rename it to better reflect what it is ?\n(not for this patch obviously)",
      "range": {
        "startLine": 254,
        "startChar": 20,
        "endLine": 254,
        "endChar": 31
      },
      "revId": "c99ea44577aa0c6763f7f34e05affe6069a24162",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": true
    },
