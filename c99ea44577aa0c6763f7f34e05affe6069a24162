    {
      "key": {
        "uuid": "bcf9300e_78439d90",
        "filename": "services/core/java/com/android/server/IpSecService.java",
        "patchSetId": 2
      },
      "lineNbr": 1902,
      "author": {
        "id": 1221725
      },
      "writtenOn": "2019-04-03T14:33:14Z",
      "side": 1,
      "message": "I\u0027m not sure it\u0027s possible to verify the FD in any trivial way. Java/Android provides no way to compare file descriptors, the inode version probably doesn\u0027t work because it\u0027s a socket instead of an actual file, and because this goes through a user process, the fd number itself will be twice-dup\u0027d, and therefore be different.\n\nAlso, this never throws a RemoteException, since it doesn\u0027t call anything over a binder. Similarly, IllegalArgumentException is a runtime exception, and my understanding of code convention is that only checked exceptions are listed in the throws.",
      "parentUuid": "08f019fc_a02be5bb",
      "range": {
        "startLine": 1902,
        "startChar": 28,
        "endLine": 1902,
        "endChar": 59
      },
      "revId": "c99ea44577aa0c6763f7f34e05affe6069a24162",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": false
    },
