    {
      "key": {
        "uuid": "50d071db_1d060076",
        "filename": "core/java/android/net/NetworkCapabilities.java",
        "patchSetId": 13
      },
      "lineNbr": 574,
      "author": {
        "id": 1107893
      },
      "writtenOn": "2017-04-11T00:36:08Z",
      "side": 1,
      "message": "Not an AI in for this patch, but it would have been nice to have along side of MatchAllSpecifier a NullSpecifier or NoSpecifier playing the role of null.",
      "range": {
        "startLine": 574,
        "startChar": 49,
        "endLine": 574,
        "endChar": 53
      },
      "revId": "a743427896d0877aacedb34ac4927691c56768db",
