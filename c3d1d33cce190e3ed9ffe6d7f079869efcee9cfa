    },
    {
      "unresolved": true,
      "key": {
        "uuid": "0583af75_d0ba7388",
        "filename": "native/graphics/jni/fuzz/fuzz_imagedecoder.cpp",
        "patchSetId": 6
      },
      "lineNbr": 131,
      "author": {
        "id": 1012974
      },
      "writtenOn": "2024-04-02T20:45:00Z",
      "side": 1,
      "message": "You should use the existing `height`. This method returns the encoded height, but you may have changed it with a call to `AImageDecoder_setTargetSize` to something larger. Then your pixel allocation will be too small.\n\nThough now that I take another look, `AImageDecoder_decodeImage` lets you pass in the allocation size, so it\u0027ll just fail. My initial concern was that the fuzzer itself would be forcing the decoder to write to memory it doesn\u0027t own, and that\u0027s not actually a problem here, thanks to that allocation size parameter. But you\u0027re effectively not testing the path that attempts to decode to a larger size.",
      "revId": "c3d1d33cce190e3ed9ffe6d7f079869efcee9cfa",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    }
