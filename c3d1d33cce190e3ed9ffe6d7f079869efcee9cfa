        "id": 1012974
      },
      "writtenOn": "2024-04-02T20:45:00Z",
      "side": 1,
      "message": "You should check the return value of `AImageDecoder_setTargetSize` and only update `width` and `height` if the function succeeds. Otherwise you\u0027re not honoring the API contract.",
      "range": {
        "startLine": 77,
        "startChar": 0,
        "endLine": 81,
        "endChar": 72
      },
      "revId": "c3d1d33cce190e3ed9ffe6d7f079869efcee9cfa",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "b95e09fe_8217ea16",
