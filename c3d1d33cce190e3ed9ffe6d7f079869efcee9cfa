        "id": 1012974
      },
      "writtenOn": "2024-04-02T20:45:00Z",
      "side": 1,
      "message": "These should use temporaries. If you reach here, you don\u0027t ever use the answer.\n\n**OR** you should follow this up with a call to `AImageDecoder_setTargetSize`",
      "range": {
        "startLine": 115,
        "startChar": 53,
        "endLine": 115,
        "endChar": 70
      },
      "revId": "c3d1d33cce190e3ed9ffe6d7f079869efcee9cfa",
