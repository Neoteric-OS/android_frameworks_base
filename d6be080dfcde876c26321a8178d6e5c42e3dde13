      },
      "lineNbr": 313,
      "author": {
        "id": 1000835
      },
      "writtenOn": "2017-11-27T07:42:20Z",
      "side": 1,
      "message": "Out of curiosity, any reason why the from*() are static methods instead of constructors?",
      "range": {
        "startLine": 311,
        "startChar": 0,
        "endLine": 313,
        "endChar": 5
      },
      "revId": "d6be080dfcde876c26321a8178d6e5c42e3dde13",
