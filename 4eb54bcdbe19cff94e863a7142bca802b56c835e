      },
      "writtenOn": "2020-01-16T18:22:09Z",
      "side": 1,
      "message": "Should we just take over that one ? Do we have a use case for keeping both ?",
      "range": {
        "startLine": 572,
        "startChar": 22,
        "endLine": 572,
        "endChar": 42
      },
      "revId": "4eb54bcdbe19cff94e863a7142bca802b56c835e",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": true
