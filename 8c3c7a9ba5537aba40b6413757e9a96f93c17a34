      "writtenOn": "2021-02-09T22:08:22Z",
      "side": 1,
      "message": "Just a question, if an app is holding a readonly FD to this proto file (it gets via our new API ), will this function call cause any negative impact ?",
      "revId": "8c3c7a9ba5537aba40b6413757e9a96f93c17a34",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
