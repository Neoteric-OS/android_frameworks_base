        "id": 1120458
      },
      "writtenOn": "2024-08-30T19:06:31Z",
      "side": 1,
      "message": "It sounds like it might not be possible, but this could be changed as well? otherwise there is a backwards compatibility concern here, because the properties are removed.",
      "range": {
        "startLine": 10,
        "startChar": 8,
        "endLine": 11,
        "endChar": 48
      },
      "revId": "f046e88a1fea62338b7bd638a6855565192a2672",
