        "id": 1015428
      },
      "writtenOn": "2021-02-06T04:33:26Z",
      "side": 1,
      "message": "As this method strongly deals with state that must only ever be touched on the handler thread (or everything goes really bad), suggest calling ensureRunningOnConnectivityServiceThread so we know if we messed up. Either do it here or in both callees below.",
      "range": {
        "startLine": 9373,
        "startChar": 17,
        "endLine": 9373,
        "endChar": 61
      },
      "revId": "d5e8efc6efd8c2fc61d5fdbe0d63655e8887e79a",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
