    {
      "key": {
        "uuid": "c019489a_61d53c53",
        "filename": "services/core/java/com/android/server/IpSecService.java",
        "patchSetId": 7
      },
      "lineNbr": 72,
      "author": {
        "id": 1060151
      },
      "writtenOn": "2017-03-28T01:42:54Z",
      "side": 1,
      "message": "I\u0027m not very trusting in this regard, and I wonder what\u0027s going to happen when someone changes the initialization order (which they honestly should be able to do). Note that doing this here means that we can do a lazy/fast getter (NetdService.getInstance()) everywhere else so no calling app should ever block for an appreciable amount of time.\nToday, there is about a 2 second delay on Marlin/Sailfish between the call to create() and the call to systemReady().",
      "parentUuid": "95fde841_5bc74e65",
