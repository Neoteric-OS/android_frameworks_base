    {
      "key": {
        "uuid": "6501ffb9_c5a87b88",
        "filename": "services/core/java/com/android/server/IpSecService.java",
        "patchSetId": 5
      },
      "lineNbr": 254,
      "author": {
        "id": 1000835
      },
      "writtenOn": "2017-12-07T10:40:26Z",
      "side": 1,
      "message": "Actually, now that I understand a bit more about this code, I would suggest making this a method that has a clear user-visible purpose: remove a reference to this object.\n\nEverything else (involving children, ...) is handled by this method so its caller doesn\u0027t have to worry about it. So perhaps just name this to \"decRef\", \"releaseReference\", \"unreference\" or similar?\n\nWith a view to rewording the docstring to something that emphasizes the primary purpose, would suggest:\n\n         * Removes a reference to this resource. If as a result of this operation this resource\n         * becomes unreferenced, then the underlying resources are freed, and references to all its\n         * child resources are dropped. Any child resources that as a result become unreferenced\n         * will free their underlying resources and drop references to their children, and so on.\n         *\n         * There must be at least one reference to this object. Calling this method on a resource\n         * that is already unreferenced will result in an IllegalStateException.",
      "parentUuid": "1561070b_04e0c5ef",
      "range": {
        "startLine": 254,
        "startChar": 20,
        "endLine": 254,
        "endChar": 52
      },
