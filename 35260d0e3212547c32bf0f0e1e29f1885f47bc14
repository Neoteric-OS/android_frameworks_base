      "writtenOn": "2017-12-07T09:23:18Z",
      "side": 1,
      "message": "I find this name unclear. Perhaps something like releaseRecursivelyWhenUnreferenced or releaseRecursivelyForUnreference? releaseAndReleaseChildren?",
      "range": {
        "startLine": 254,
        "startChar": 20,
        "endLine": 254,
        "endChar": 52
      },
      "revId": "35260d0e3212547c32bf0f0e1e29f1885f47bc14",
