      "writtenOn": "2020-12-22T12:05:07Z",
      "side": 1,
      "message": "Is it possible at all that only the refresh time is set ? If so, this logic will simply ignore it if, e.g. the NA info is completely absent, and the Capport info only has refresh time.",
      "range": {
        "startLine": 6142,
        "startChar": 20,
        "endLine": 6142,
        "endChar": 39
      },
      "revId": "01f3d2b03e4a7867028da02dd8dbbe002212a599",
