      "writtenOn": "2019-01-10T05:06:05Z",
      "side": 1,
      "message": "It looks like these are accessed both on the validation threads and on the test thread. Maybe make them volatile?",
      "revId": "3f3a1e41a66eca4225a8b8a5d022f2e7cb1e5288",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
