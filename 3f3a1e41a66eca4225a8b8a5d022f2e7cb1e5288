    {
      "key": {
        "uuid": "d527949e_395ce2e2",
        "filename": "tests/net/java/com/android/server/ConnectivityServiceTest.java",
        "patchSetId": 11
      },
      "lineNbr": 467,
      "author": {
        "id": 1000835
      },
      "writtenOn": "2019-01-10T05:06:05Z",
      "side": 1,
      "message": "This is actually not realistic. Here, revalidating a network twice will start two parallel threads which will race with each other. But actual NetworkMonitor behaviour (and the current behaviour of this unit test) is that all validation attempts occur in sequence on the same thread. What that means is that if the test ever re-evaluates a network without waiting for the result of the previous evaluation, then it could get confused.\n\nProbably fine for now, but maybe add a TODO to give the fake NetworkMonitor a handler thread?",
      "range": {
        "startLine": 467,
        "startChar": 16,
        "endLine": 467,
        "endChar": 26
      },
      "revId": "3f3a1e41a66eca4225a8b8a5d022f2e7cb1e5288",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": true
    },
    {
      "key": {
