      "writtenOn": "2019-01-31T00:14:57Z",
      "side": 1,
      "message": "Until the user hits send, the message should not be persisted in the db, should it?",
      "parentUuid": "77b487da_f67f5ca3",
      "range": {
        "startLine": 121,
        "startChar": 7,
