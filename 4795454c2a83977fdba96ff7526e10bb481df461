        "filename": "telephony/java/android/telephony/ims/RcsGroupThreadParticipantLeftEvent.java",
        "patchSetId": 2
      },
      "lineNbr": 104,
      "author": {
        "id": 1054648
      },
      "writtenOn": "2019-01-31T00:14:57Z",
      "side": 1,
      "message": "Sure, or avoid back to back calls to buildAndSave.",
      "parentUuid": "e22dba02_76e84874",
      "revId": "4795454c2a83977fdba96ff7526e10bb481df461",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": true
