    {
      "key": {
        "uuid": "d82fbd46_2b77cd28",
        "filename": "telephony/java/android/provider/Telephony.java",
        "patchSetId": 2
      },
      "lineNbr": 2061,
      "author": {
        "id": 1318036
      },
      "writtenOn": "2019-02-01T02:16:35Z",
      "side": 1,
      "message": "I am sorry that I wasn\u0027t clear on this before asking for a review: The changes I made in this class are not meant to be public. The API users don\u0027t need to know what the columns are called. These are here so that we can use them in both framework, the controller and provider without duplicating the string values.\n\nThat being said, due to our design decision of trying to comply with 3rd normal form as much as possible, there are some complex queries in the provider that does multiple joins, unions etc. In order to prevent confusion in these (e.g. a table having multiple foreign keys to two different tables, and all three having an _ID column) we went with a more expressive naming schema. I should update the design doc with the naming.\n\nIn patchset 4 I marked these kind of classes with the following to be clear - sorry again for the confusion:\n\n@hide - not meant for public use",
      "parentUuid": "e0c45dc6_9fab922f",
      "range": {
        "startLine": 2061,
        "startChar": 32,
        "endLine": 2061,
        "endChar": 51
      },
      "revId": "4795454c2a83977fdba96ff7526e10bb481df461",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": false
    },
