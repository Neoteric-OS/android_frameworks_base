      "key": {
        "uuid": "1e3bdf45_0faa56f9",
        "filename": "telephony/java/android/telephony/ims/RcsIncomingMessage.java",
        "patchSetId": 2
      },
      "lineNbr": 41,
      "author": {
        "id": 1318036
      },
      "writtenOn": "2019-01-30T19:29:18Z",
      "side": 1,
      "message": "This is mainly due to following: assume that Alice send Bob two messages, \"Hello\" and \"What\u0027s up\". It is possible that \"What\u0027s up\" arrives first and \"Hello\" second. At that point, their \norigination timestamps would be in order, but the arrival timestamps would be out of order. The origination timestamps are also not reliable in the sense that the sending app or the server can mess these up. I\u0027d like to offer the flexibility for the messaging app to fix this up retroactively, as we do in some cases in Android Messages.",
      "parentUuid": "66864344_efb464a8",
      "range": {
        "startLine": 41,
        "startChar": 16,
        "endLine": 41,
        "endChar": 35
      },
