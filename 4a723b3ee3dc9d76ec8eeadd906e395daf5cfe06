      "writtenOn": "2020-12-18T01:21:37Z",
      "side": 1,
      "message": "Oh, whoops. this is outdated. The retrieval is now from a SELinux-guarded file on full-disk encrypted storage, as above. Removed.",
      "parentUuid": "c141dc9d_69870d47",
      "range": {
        "startLine": 225,
        "startChar": 8,
        "endLine": 225,
        "endChar": 57
      },
      "revId": "4a723b3ee3dc9d76ec8eeadd906e395daf5cfe06",
