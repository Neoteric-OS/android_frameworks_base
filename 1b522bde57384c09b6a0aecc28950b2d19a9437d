      },
      "writtenOn": "2024-08-29T15:03:52Z",
      "side": 1,
      "message": "What sort of applications are you imagining using ASTC resources?",
      "parentUuid": "4b786df0_cd89c9fd",
      "revId": "1b522bde57384c09b6a0aecc28950b2d19a9437d",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
