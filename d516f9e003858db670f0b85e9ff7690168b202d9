      },
      "lineNbr": 1069,
      "author": {
        "id": 1000835
      },
      "writtenOn": "2021-01-18T14:00:56Z",
      "side": 1,
      "message": "The test is not single-threaded, these ConditionVariables are opened on the CS handler thread where LockdownVpnTracker runs. So there has to be some cross-thread waiting primitive here. (In the future this might move to the ConnectivityThread and be driven by networkcallbacks, but the issue is the same, there needs to be some waiting involved.)",
      "parentUuid": "7088cb19_e50a3a73",
      "range": {
        "startLine": 1068,
        "startChar": 0,
        "endLine": 1069,
        "endChar": 77
      },
