        "id": 1010681
      },
      "writtenOn": "2019-07-01T13:39:58Z",
      "side": 1,
      "message": "The aim is to minimize memory usage - a flat array is the smallest we can make this. And I believe a hashmap lookup is not always faster for small amounts of data.",
      "parentUuid": "e0b0c39a_294176a3",
      "range": {
        "startLine": 55,
        "startChar": 19,
        "endLine": 55,
        "endChar": 31
