      },
      "writtenOn": "2010-07-29T20:17:32Z",
      "side": 1,
      "message": "Not only is the contract with the RIL changed but moving the dcTracker.sendMessage inside the else clause means that there is a change in the contract with the dcTracker too.\n\nWhy was that done?",
      "parentUuid": "AAAA0n///U0\u003d",
      "revId": "7620c79047b8bc08afa3470bf73f15078e8c6563",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": false
    },
    {
