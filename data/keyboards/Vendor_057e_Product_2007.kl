# Nintendo Switch Joycon(R) - HAC-016 - Bluetooth

# Mapping according to https://developer.android.com/training/game-controllers/controller-input.html

# Button labeled as "B" but should really produce keycode "A"
key 304   BUTTON_A
# Button labeled as "A" but should really produce keycode "B"
key 305   BUTTON_B
# Button labeled as "X" but should really produce keycode "Y"
key 307   BUTTON_Y
# Button labeled as "Y" but should really produce keycode "X"
key 308   BUTTON_X

# Button labeled as "R"
key 311   BUTTON_R1
# No RT axes on this controller. Instead, there are keys.
# Trigger labeled as "ZR"
key 313   BUTTON_R2

# Right stick click
key 318   BUTTON_THUMBR

# Mapping according to https://www.kernel.org/doc/Documentation/input/gamepad.txt
# Plus
key 315   BUTTON_START

# Home key
key 316   HOME

# Right Analog Stick
axis 0x03    Z
axis 0x04    RZ