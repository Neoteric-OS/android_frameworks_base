      "author": {
        "id": 1000835
      },
      "writtenOn": "2022-12-22T09:26:08Z",
      "side": 1,
      "message": "... or is the expectation that any OEM launching a U device with a T-era kernel would fail CTS, then go and change this code?",
      "parentUuid": "330d13b8_21a53480",
      "range": {
        "startLine": 1523,
        "startChar": 49,
        "endLine": 1523,
        "endChar": 79
      },
      "revId": "c2a39352841f7dc540db0d3dde3050568999af54",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": false,
      "key": {
        "uuid": "6ec76da3_d7a45869",
        "filename": "core/java/com/android/server/SystemConfig.java",
        "patchSetId": 7
