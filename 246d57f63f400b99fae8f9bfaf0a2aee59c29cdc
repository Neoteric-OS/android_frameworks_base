      },
      "lineNbr": 660,
      "author": {
        "id": 1974730
      },
      "writtenOn": "2023-10-10T17:38:13Z",
      "side": 1,
      "message": "I believe you will get a nonzero value. There are no methods in `IKeystoreAuthorization` that remove or invalidate prior hardware auth tokens.",
