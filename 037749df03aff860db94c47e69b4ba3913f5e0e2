    {
      "key": {
        "uuid": "18dc0522_47b69a8b",
        "filename": "telephony/java/android/telephony/ims/feature/SmsFeature.java",
        "patchSetId": 5
      },
      "lineNbr": 213,
      "author": {
        "id": 1098053
      },
      "writtenOn": "2017-11-30T16:04:51Z",
      "side": 1,
      "message": "Basically this is to accommodate vendor ImsServices that can switch between 3gpp and 3gpp2 format, depending on the carrier network they are registered to.\n\nBy default, if the SmsFeature doesn\u0027t override this method, then we assume the SmsFeature is always using 3gpp. If the SmsFeature overrides the method, then they can switch between the two formats.",
      "parentUuid": "79840346_271e90b3",
      "range": {
        "startLine": 211,
        "startChar": 0,
        "endLine": 213,
        "endChar": 3
      },
      "revId": "037749df03aff860db94c47e69b4ba3913f5e0e2",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": false
    },
