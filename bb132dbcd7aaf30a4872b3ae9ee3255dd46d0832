    {
      "key": {
        "uuid": "87885c6a_890b5adf",
        "filename": "api/system-current.txt",
        "patchSetId": 7
      },
      "lineNbr": 3170,
      "author": {
        "id": 1308473
      },
      "writtenOn": "2019-03-19T05:55:05Z",
      "side": 1,
      "message": "If we change all addXyz methods to be @NonNull, the setXyz methods are consistent with the addXyz methods.",
      "parentUuid": "567a8696_a8d8d562",
      "range": {
        "startLine": 3170,
        "startChar": 39,
        "endLine": 3170,
        "endChar": 47
      },
      "revId": "bb132dbcd7aaf30a4872b3ae9ee3255dd46d0832",
