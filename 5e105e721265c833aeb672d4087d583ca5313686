      "writtenOn": "2020-03-04T14:08:00Z",
      "side": 1,
      "message": "Hm, I see some benefits of changing the loading order, but do they outweigh having explicit setLoadingOrder API?",
      "revId": "5e105e721265c833aeb672d4087d583ca5313686",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": true
