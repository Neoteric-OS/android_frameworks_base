      "writtenOn": "2022-03-31T06:50:33Z",
      "side": 1,
      "message": "Is it similar concern as the comment above? Caller may probably need to get the allowed algorithm from IkeTunnelConnectionParams. All the IKE related getter may not be able to provide correct information if an IkeTunnelConnectionParams is set.",
      "parentUuid": "7f1f4429_b7047e61",
      "range": {
        "startLine": 363,
        "startChar": 0,
        "endLine": 366,
        "endChar": 5
