      },
      "writtenOn": "2022-03-31T06:50:33Z",
      "side": 1,
      "message": "A getter to retrieve IkeTunnelConnectionParams was done in aosp/2029924",
      "parentUuid": "2a0c5766_b4536be9",
      "range": {
        "startLine": 299,
        "startChar": 4,
        "endLine": 354,
