        "id": 1121403
      },
      "writtenOn": "2021-01-07T00:01:16Z",
      "side": 1,
      "message": "do we want to leave a bundle here just in case a protocol need to pass in some parameters to the client before a session is started? the bundle can be empty when it is not needed",
      "range": {
        "startLine": 124,
        "startChar": 13,
        "endLine": 124,
        "endChar": 55
      },
      "revId": "d5bf4b39ede82a5ff0b1800df59585c176b2352f",
