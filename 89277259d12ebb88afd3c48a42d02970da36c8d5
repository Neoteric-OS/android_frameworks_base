      "writtenOn": "2019-02-13T21:17:23Z",
      "side": 1,
      "message": "I agree. Its a better thing to do in practice - http://go/java-practices/mutability#defensive",
      "parentUuid": "7561ac70_689187a5",
      "range": {
        "startLine": 294,
