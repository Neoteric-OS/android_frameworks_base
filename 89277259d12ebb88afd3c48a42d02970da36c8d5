    {
      "key": {
        "uuid": "7e38ae62_48e2240f",
        "filename": "services/core/java/com/android/server/connectivity/Vpn.java",
        "patchSetId": 5
      },
      "lineNbr": 294,
      "author": {
        "id": 1399364
      },
      "writtenOn": "2019-02-13T06:31:54Z",
      "side": 1,
      "message": "mNetworkCaps can get mutated in other places, which is why I think it is better to return its current state/value.\n\n\u003e The constructor is a shallow copy constructor anyway.\n\nThis does not applies to fields that really matter such as capabilities and transport types in NC which are of type long.",
      "parentUuid": "390ca8b1_9979c3c0",
      "range": {
        "startLine": 294,
        "startChar": 15,
        "endLine": 294,
        "endChar": 18
      },
      "revId": "89277259d12ebb88afd3c48a42d02970da36c8d5",
