    {
      "key": {
        "uuid": "5c3a07a8_43c56224",
        "filename": "core/java/android/net/NetworkStats.java",
        "patchSetId": 21
      },
      "lineNbr": 1228,
      "author": {
        "id": 1015428
      },
      "writtenOn": "2019-03-25T21:28:55Z",
      "side": 1,
      "message": "I\u0027m generally in favor of code formatters but I\u0027m not aware of any we\u0027re using in Android.\n\nI don\u0027t remember seeing this style of argument in Java code any more than very anecdotically, and certainly never in Android. It is, to the best of my understanding, not in contravention of our style guidelines (and in fact the Kotlin guidelines mandate this style (for parameters, not for calls)), but the thing is the one point the style guide is very adamant on is conformance to local style.\n\nWhat formatter are you using ? Are there any switches on it that you could use to keep closer to the standard style ?",
      "parentUuid": "6f15827c_82a571d4",
      "range": {
        "startLine": 1224,
        "startChar": 12,
        "endLine": 1228,
        "endChar": 40
      },
      "revId": "62cff1d1cae3a31bd6f91b8ccd3e40933f0720d9",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": false
    },
