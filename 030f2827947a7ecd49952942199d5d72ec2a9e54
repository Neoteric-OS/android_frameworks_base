      "writtenOn": "2019-06-24T09:53:09Z",
      "side": 1,
      "message": "Which docs did you see that in? We\u0027re using android.util.LongArray here which doesn\u0027t seem to have those semantics.",
      "parentUuid": "562b6ff0_08cfc529",
      "range": {
        "startLine": 79,
