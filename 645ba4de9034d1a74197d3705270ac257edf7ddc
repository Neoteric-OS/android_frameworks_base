      "writtenOn": "2021-02-23T13:13:47Z",
      "side": 1,
      "message": "On second thought, maybe you could just add a mContext.checkCallingPermission(...) with a new permission (similar to OVERRIDE_COMPAT_CHANGE_CONFIG)",
      "range": {
        "startLine": 107,
        "startChar": 19,
        "endLine": 107,
        "endChar": 33
      },
      "revId": "645ba4de9034d1a74197d3705270ac257edf7ddc",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
