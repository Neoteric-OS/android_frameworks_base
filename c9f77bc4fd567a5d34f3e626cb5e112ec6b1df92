      "writtenOn": "2019-03-13T18:20:57Z",
      "side": 1,
      "message": "I think onAnswer should contain available answer.(at least 1 INetAddress)\nWhat do you think about it?",
      "parentUuid": "a63345ba_07a14ddc",
