    {
      "key": {
        "uuid": "2c7d3e5f_69d5a5e1",
        "filename": "core/java/android/net/NetworkCapabilities.java",
        "patchSetId": 3
      },
      "lineNbr": 254,
      "author": {
        "id": 1000835
      },
      "writtenOn": "2017-10-30T06:31:11Z",
      "side": 1,
      "message": "Note that this will ensure that a user cannot call requestNetwork with this capability (but *can* call registerNetworkCallback).\n\nThis is due to NON_REQUESTABLE_CAPABILITIES below, and the reason for this limitation is that the connectivity code by itself does not prevent looping in the presence of requests for mutable capabilities. What can happen is:\n\n 1. App calls requestNetwork with mutable capability.\n 2. ConnectivityService sends request to NetworkFactories.\n 3. Network connects, but lacks capability, or after a while loses capability\n   (which is possible because by definition mutable capabilities can change\n   while the network is connected).\n 4. ConnectivityService tears down network as it has no requests matching it.\n 5. Goto 2.\n\nIf we\u0027re OK with the fact that we cannot call requestNetwork with NET_CAPABILITY_NOT_ROAMING, that\u0027s fine, but if not, we should think about this.\n\nOne possible alternative is to say that NET_CAPABILITY_NOT_ROAMING cannot change while the network is connected (not sure if this is possible). Another possible alternative is to put safeguards against this into TelephonyNetworkFactory.\n\nHugo has also floated the idea that the connectivity code should not be responsible to preventing this sort of loop, and that that is entirely the responsibility of the network factory.",
      "range": {
        "startLine": 254,
        "startChar": 18,
        "endLine": 254,
        "endChar": 44
      },
      "revId": "26121c347843948ee77e16bc417f7f2cce23186e",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": false
    },
