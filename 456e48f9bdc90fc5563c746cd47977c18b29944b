      "writtenOn": "2023-11-02T11:34:12Z",
      "side": 1,
      "message": "There is already onUserPasswordChanged(), which is a bit confusing alongside onUserLskfRemoved(). Is it possible to merge them together? (onUserPasswordChanged() is probably a bad name nowadays)",
      "range": {
        "startLine": 144,
        "startChar": 22,
