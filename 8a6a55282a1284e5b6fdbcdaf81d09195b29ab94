      "writtenOn": "2019-01-08T13:31:35Z",
      "side": 1,
      "message": "won\u0027t this attempt to set this property from arbitrary privileged processes result in an SELinux denial ? (or do you plan on getting rid of it later)",
      "range": {
        "startLine": 129,
        "startChar": 7,
        "endLine": 129,
        "endChar": 55
      },
      "revId": "8a6a55282a1284e5b6fdbcdaf81d09195b29ab94",
