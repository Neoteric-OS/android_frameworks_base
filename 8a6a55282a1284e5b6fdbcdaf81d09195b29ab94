      "unresolved": true
    },
    {
      "key": {
        "uuid": "3cf5e6b7_a5d501be",
        "filename": "core/java/android/os/BugreportManager.java",
        "patchSetId": 10
      },
      "lineNbr": 129,
      "author": {
        "id": 1014443
      },
      "writtenOn": "2019-01-09T09:57:57Z",
      "side": 1,
      "message": "If I read this right, this code isn\u0027t running in the system server process, it\u0027s running in the app process. If you want to run this in the system server process, you\u0027ll have to define a new (private) binder interface and a corresponding system server to handle it.\n\nRunning this in the system server process is probably the right thing to do, since it will also allow you to limit the set of processes that can fetch the dumpstate service.",
      "parentUuid": "5ccef598_c1c44b9e",
