    {
      "key": {
        "uuid": "5ccef598_c1c44b9e",
        "filename": "core/java/android/os/BugreportManager.java",
        "patchSetId": 10
      },
      "lineNbr": 129,
      "author": {
        "id": 1336554
      },
      "writtenOn": "2019-01-08T13:59:39Z",
      "side": 1,
      "message": "No, I intend to keep this. This is a oneshot service. Do you mean that though this code is in system server process, it will run in the context of the calling app? How can we get around that?",
      "parentUuid": "500e0103_7acdab8a",
      "range": {
        "startLine": 129,
        "startChar": 7,
        "endLine": 129,
        "endChar": 55
      },
      "revId": "8a6a55282a1284e5b6fdbcdaf81d09195b29ab94",
