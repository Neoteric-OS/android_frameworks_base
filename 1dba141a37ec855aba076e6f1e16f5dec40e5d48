    {
      "key": {
        "uuid": "f6c96ea3_527d04a7",
        "filename": "services/core/java/com/android/server/IpSecService.java",
        "patchSetId": 1
      },
      "lineNbr": 167,
      "author": {
        "id": 1221725
      },
      "writtenOn": "2017-11-15T20:23:19Z",
      "side": 1,
      "message": "Theoretically that would be ok; By adding a dependency to the array multiple times, it the decrementRefcount will be called on it during cleanup multiple times as well. \n\nOnly upon the refcount reaching 0 would the actual release be called; calling decrementRefcount() more than once just brings the refcount towards 0, and calling releaseIfUnreferencedRecursively() does nothing unless the refcount is 0",
      "parentUuid": "e3834fc4_b9c50445",
      "range": {
        "startLine": 167,
        "startChar": 12,
        "endLine": 167,
        "endChar": 50
      },
      "revId": "1dba141a37ec855aba076e6f1e16f5dec40e5d48",
