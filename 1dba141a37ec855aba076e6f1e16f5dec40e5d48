      "writtenOn": "2017-11-15T00:08:47Z",
      "side": 1,
      "message": "This does not do deduplication if the same thing is added as a dependency more than once. Is this ok ? What happens an IResource gets cleanup()/released() more than once ?",
      "range": {
        "startLine": 167,
        "startChar": 12,
        "endLine": 167,
        "endChar": 50
      },
      "revId": "1dba141a37ec855aba076e6f1e16f5dec40e5d48",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": false
