    {
      "unresolved": true,
      "key": {
        "uuid": "734acccb_db6facf0",
        "filename": "services/core/java/com/android/server/security/rkp/RemoteProvisioningService.java",
        "patchSetId": 3
      },
      "lineNbr": 162,
      "author": {
        "id": 1139038
      },
      "writtenOn": "2023-04-18T13:50:00Z",
      "side": 1,
      "message": "The minimum seemed useful for finding the HALs that have plaintext CSRs to pull out in EDI (i.e. they implement `generateCertificateRequestV2()`). It\u0027s all hardware info versions.",
      "parentUuid": "4b8ae18a_98bb79c2",
      "range": {
        "startLine": 162,
        "startChar": 28,
        "endLine": 162,
        "endChar": 55
      },
      "revId": "3f886c2700eae03153187110a9171ea40bc61851",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "773b3b35_73145311",
        "filename": "services/core/java/com/android/server/security/rkp/RemoteProvisioningService.java",
        "patchSetId": 3
      },
      "lineNbr": 162,
      "author": {
        "id": 1833664
      },
      "writtenOn": "2023-04-18T17:09:42Z",
      "side": 1,
      "message": "We will (soon!) be able to decrypt even the old style ones to extract the info we need. So I think it\u0027s useful to grab CSRs from all versions.",
      "parentUuid": "734acccb_db6facf0",
      "range": {
        "startLine": 162,
        "startChar": 28,
        "endLine": 162,
        "endChar": 55
      },
      "revId": "3f886c2700eae03153187110a9171ea40bc61851",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
