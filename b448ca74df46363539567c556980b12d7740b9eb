    {
      "key": {
        "uuid": "8022e907_d244eb63",
        "filename": "core/java/android/net/ConnectivityManager.java",
        "patchSetId": 2
      },
      "lineNbr": 2772,
      "author": {
        "id": 1015428
      },
      "writtenOn": "2019-03-07T04:21:35Z",
      "side": 1,
      "message": "I think generally speaking the plan is to remove this API as soon as you can tell us it\u0027s okay. Typically this will mean R, because it\u0027s the soonest that you will be able to tell us no GMSCore version that uses this call will ever run on R.\nDepending on what\u0027s in GMSCore future it\u0027s also possible we have to keep this for much longer because maybe you can\u0027t ever guarantee GMSCore 26 can\u0027t run on R.\n\nThen there are the @UnsupportedAppUsage considerations that come into play for @SystemApi, which hopefully can\u0027t affect this thanks to the permissions check.\n\nThat\u0027s why we weren\u0027t very keen on being asked to provide something immediately that we can\u0027t change : it\u0027s typically a multi-year commitment for us. But the ship has sailed on this.",
      "parentUuid": "86380c83_12ef25df",
      "revId": "b448ca74df46363539567c556980b12d7740b9eb",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": false
