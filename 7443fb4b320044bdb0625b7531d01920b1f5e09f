    {
      "key": {
        "uuid": "ea24343f_db6f2bdd",
        "filename": "core/java/android/net/VpnManager.java",
        "patchSetId": 27
      },
      "lineNbr": 31,
      "author": {
        "id": 1221725
      },
      "writtenOn": "2020-01-17T00:24:51Z",
      "side": 1,
      "message": "After discussion with Nathan, I think we don\u0027t quite see any use case for an opportunistic VPN profile, which seems like it might be the only use case where we would need it.\n\nIf an app is very much determined to do so, they could have a foreground service that removes the profile once the conditions are no longer met.\n\nI\u0027ll leave this open for Jean to comment if he feels one way or another, but my position right now is it\u0027s slightly out of scope.",
      "parentUuid": "073b351b_d6a51b57",
      "range": {
        "startLine": 30,
        "startChar": 91,
        "endLine": 31,
        "endChar": 6
      },
      "revId": "7443fb4b320044bdb0625b7531d01920b1f5e09f",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": true
    },
    {
      "key": {
