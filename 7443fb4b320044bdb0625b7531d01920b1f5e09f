        "patchSetId": 27
      },
      "lineNbr": 31,
      "author": {
        "id": 1399364
      },
      "writtenOn": "2020-01-18T00:20:26Z",
      "side": 1,
      "message": "It should be fine to leave this out, iff we also make changes to VpnSettings such that it grays out always-on and lockdown mode options from VPN Settings if there is no profile installed by the VPN app.",
      "parentUuid": "ea24343f_db6f2bdd",
      "range": {
        "startLine": 30,
        "startChar": 91,
        "endLine": 31,
        "endChar": 6
      },
