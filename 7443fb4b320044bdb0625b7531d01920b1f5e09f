      "writtenOn": "2020-01-16T22:10:01Z",
      "side": 1,
      "message": "We should also allow platform based VPNs to opt-out of always-on setting. This behavior is generally supported by VpnService based VPNs.\n\nSee also developer guide that explains how one could do this: https://developer.android.com/guide/topics/connectivity/vpn#opt_out_of_always-on\n\nSide note: We should also update this guide.",
      "range": {
        "startLine": 30,
        "startChar": 91,
        "endLine": 31,
        "endChar": 6
      },
      "revId": "7443fb4b320044bdb0625b7531d01920b1f5e09f",
