        "id": 1399364
      },
      "writtenOn": "2020-01-16T22:19:44Z",
      "side": 1,
      "message": "Given that platform VPNs don\u0027t have to define a VpnService in the manifest - you could provision always-on support setting via PlatformVpnProfile.",
      "parentUuid": "4846d3c6_9b13dfb0",
      "range": {
        "startLine": 30,
        "startChar": 91,
        "endLine": 31,
        "endChar": 6
      },
      "revId": "7443fb4b320044bdb0625b7531d01920b1f5e09f",
