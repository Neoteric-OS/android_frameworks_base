rust_library {
    name: "libse_service",
    crate_name: "se_service",
    srcs: ["src/lib.rs"],
    rustlibs: [
        "android.hardware.secure_element-V1-rust",
        "android.os.permissions_aidl-rust",
        "android.se.omapi-V2-rust",
        "libandroid_logger",
        "libanyhow",
        "libbinder_rs",
        "libhex",
        "liblog_rust",
        "packagemanager_aidl-rust",
    ],
    lints: "none",
    clippy_lints: "none",
}

rust_binary {
    name: "secure_element_service",
    srcs: ["src/secure_element_service_main.rs"],
    rustlibs: [
        "android.os.permissions_aidl-rust",
        "libandroid_logger",
        "libanyhow",
        "libbinder_rs",
        "liblog_rust",
        "librustutils",
        "libse_service",
        "packagemanager_aidl-rust",
    ],
    lints: "none",
    clippy_lints: "none",
}

rust_test {
    name: "se_service_test",
    crate_name: "se_service",
    test_suites: ["general-tests"],
    auto_gen_config: true,
    srcs: ["src/lib.rs"],
    rustlibs: [
        "android.hardware.secure_element-V1-rust",
        "android.os.permissions_aidl-rust",
        "android.se.omapi-V2-rust",
        "libandroid_logger",
        "libanyhow",
        "libbinder_rs",
        "libhex",
        "liblog_rust",
        "packagemanager_aidl-rust",
    ],
    require_root: true,
    lints: "none",
    clippy_lints: "none",
}
