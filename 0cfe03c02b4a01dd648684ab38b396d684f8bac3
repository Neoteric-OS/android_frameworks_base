      "author": {
        "id": 1306837
      },
      "writtenOn": "2021-03-02T14:16:46Z",
      "side": 1,
      "message": "+1\nOr is it possible to mix-in a NetworkCapabilities object?\nLike what we did for nai.declaredCapabilities",
      "parentUuid": "b4d42670_9008da44",
      "range": {
        "startLine": 9050,
        "startChar": 22,
        "endLine": 9050,
        "endChar": 32
      },
      "revId": "0cfe03c02b4a01dd648684ab38b396d684f8bac3",
