      "writtenOn": "2020-03-18T12:16:09Z",
      "side": 1,
      "message": "question: why you need to define a new transport constant instead of using exising one?",
      "range": {
        "startLine": 4936,
        "startChar": 60,
        "endLine": 4936,
        "endChar": 87
      },
      "revId": "6cabd278c5bc5303d368a27d988a11bcdf642a20",
