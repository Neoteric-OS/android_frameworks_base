      },
      "lineNbr": 1045,
      "author": {
        "id": 1004300
      },
      "writtenOn": "2010-10-05T08:57:33Z",
      "side": 1,
      "message": "This is to handle OTA refresh of PNN/OPL files.\nIf we just depend on onAllRecords loaded, then any file refresh will trigger EONS.\nPlease suggest if the OTA refresh case can be handled better.",
      "parentUuid": "AAAA73///4A\u003d",
      "revId": "fff5d2bdddc337e0343b8daba8c8a6c1c79be319",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
