    {
      "key": {
        "uuid": "677982f8_983edbf2",
        "filename": "core/java/android/net/NetworkCapabilities.java",
        "patchSetId": 11
      },
      "lineNbr": 1552,
      "author": {
        "id": 1015428
      },
      "writtenOn": "2020-01-22T02:58:56Z",
      "side": 1,
      "message": "If I\u0027m reading this check correctly that means if an app sends a NC with a UID that\u0027s neither its UID or the UID of the system process, it will not be reset.\n\nAlso do keep in mind this will never be useful in the other direction because this is running on the receiving side, which is entirely under the app\u0027s control.\n\nMore generally speaking I don\u0027t think the parceling code should be the place this is enforced, because it\u0027s unexpected to developers familiar with parceling ; parceling code doing stuff different from just sending things as is should be very rare because it\u0027s ① very difficult to get right ② always unexpected.\n\nConnectivityService already has code that enforces sanity for NCs coming from apps (networkCapabilitiesRestrictedForCallerPermissions, you already found that). I think this should be migrated there instead.",
      "range": {
        "startLine": 1551,
        "startChar": 14,
        "endLine": 1552,
        "endChar": 71
      },
      "revId": "9d6ca6bfdf1efb38ded72d0ee7f063ef7107ca1b",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": true
    },
    {
      "key": {
        "uuid": "6709cec2_d753a5c6",
        "filename": "services/core/java/com/android/server/ConnectivityService.java",
