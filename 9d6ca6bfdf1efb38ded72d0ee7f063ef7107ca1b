      "side": 1,
      "message": "This is not written to the parcel, you should not read it.",
      "range": {
        "startLine": 1548,
        "startChar": 16,
        "endLine": 1548,
        "endChar": 48
      },
      "revId": "9d6ca6bfdf1efb38ded72d0ee7f063ef7107ca1b",
