      "writtenOn": "2024-10-07T16:06:12Z",
      "side": 1,
      "message": "No, in WebViews older than M122, initialization is not automatic. This API calls into the old GMS library to initialize Safe Browsing and then sends back a response async. The new GMS library does not expose any initialization API, so we don\u0027t need to call it.",
      "parentUuid": "db39723a_56ab3f2d",
      "range": {
        "startLine": 1498,
        "startChar": 38,
        "endLine": 1498,
        "endChar": 79
      },
      "revId": "79e67b822720650456ad7207bcd264395519f2b8",
