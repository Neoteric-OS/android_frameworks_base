package {
    default_applicable_licenses: ["frameworks_base_license"],
}

java_fuzz {
    name: "hint_manager_service_fuzzer",
    srcs: [
        "src/**/*.java",
        ":framework-core-sources-for-hint-fuzzers",
        ":framework-core-sources-for-fuzzers",
        ":hint_manager_fuzzer_sources",
    ],
    static_libs: [
        "jazzer",
        "random_parcel_lib",
    ],
    jni_libs: [
        "librandom_parcel_jni",
        "libc++",
        "libandroid_runtime",
        "libandroid_servers",
    ],
    libs: [
        "core-libart",
        "services",
        "framework-internal-utils",
        "framework",
        "unsupportedappusage",
        "ext",
        "android.test.mock",
    ],
    native_bridge_supported: true,
    fuzz_config: {
        cc: [
            "smoreland@google.com",
            "waghpawan@google.com",
        ],
        // Adds bugs to hotlist "AIDL fuzzers bugs" on buganizer
        hotlists: ["4637097"],
    },
}
