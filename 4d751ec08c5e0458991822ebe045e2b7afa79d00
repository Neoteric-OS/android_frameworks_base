      "writtenOn": "2023-02-10T22:08:08Z",
      "side": 1,
      "message": "Would it perhaps be more natural to report the manufacturing date as a string in the YYYYMMDD or YYYY-MM-DD format? I cannot imagine anyone caring about the exact second when the battery got off the conveyor belt.",
      "parentUuid": "0b796edd_d9dc24b5",
      "revId": "4d751ec08c5e0458991822ebe045e2b7afa79d00",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
