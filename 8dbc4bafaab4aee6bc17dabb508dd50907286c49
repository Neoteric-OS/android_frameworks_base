      "writtenOn": "2019-04-05T09:52:43Z",
      "side": 1,
      "message": "This is inconsistent with the other options: for the other options, the resource takes precedence over the setting, but for this one, the setting takes precedence over the resource.\n\nGiven that we are now allowing OEMs to override these options, should we do the same here? There shouldn\u0027t be backwards compatibility concerns because this has not been possible before.",
      "range": {
        "startLine": 6707,
        "startChar": 0,
        "endLine": 6709,
        "endChar": 9
      },
      "revId": "8dbc4bafaab4aee6bc17dabb508dd50907286c49",
