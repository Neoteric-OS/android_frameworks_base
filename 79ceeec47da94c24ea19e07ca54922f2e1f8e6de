      },
      "writtenOn": "2019-09-10T07:29:42Z",
      "side": 1,
      "message": "How strong is your guarantee that this will never overlap the possible interface names for regular wifi tethering ?",
      "range": {
        "startLine": 825,
        "startChar": 56,
        "endLine": 825,
        "endChar": 68
      },
      "revId": "79ceeec47da94c24ea19e07ca54922f2e1f8e6de",
