      "unresolved": true
    },
    {
      "key": {
        "uuid": "029d4c10_54dc9d06",
        "filename": "services/core/java/com/android/server/connectivity/Tethering.java",
        "patchSetId": 7
      },
      "lineNbr": 825,
      "author": {
        "id": 1322948
      },
      "writtenOn": "2019-09-12T08:38:04Z",
      "side": 1,
      "message": "When framework handles group formed event, it ensures group ifname is not null.\nThis ifname is generated from native daemon (supplicant) with an incremental index, ex. p2p-p2p0-1.\nThis index is reset only when wifi is turned off via airplane mode.",
      "parentUuid": "da3920d3_e402b7fb",
      "range": {
        "startLine": 825,
        "startChar": 56,
        "endLine": 825,
        "endChar": 68
      },
      "revId": "79ceeec47da94c24ea19e07ca54922f2e1f8e6de",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": true
    },
