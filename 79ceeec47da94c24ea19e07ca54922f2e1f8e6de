      "unresolved": true
    },
    {
      "key": {
        "uuid": "0034058f_1eec7ed9",
        "filename": "services/core/java/com/android/server/connectivity/Tethering.java",
        "patchSetId": 7
      },
      "lineNbr": 815,
      "author": {
        "id": 1322948
      },
      "writtenOn": "2019-09-12T08:38:04Z",
      "side": 1,
      "message": "The only different is the p2p info is cleared upon leaving a  group. (or say, the life time follows the group).\nIn other words, when I got a disconnection broadcast, p2pInfo.isGroupOwner is always false, but group is still valid for detecting whether this device is group owner.",
      "parentUuid": "45e6455d_0b0bab54",
      "range": {
        "startLine": 815,
        "startChar": 34,
        "endLine": 815,
        "endChar": 54
      },
      "revId": "79ceeec47da94c24ea19e07ca54922f2e1f8e6de",
