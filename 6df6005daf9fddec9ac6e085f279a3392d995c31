      "writtenOn": "2021-01-06T00:57:26Z",
      "side": 1,
      "message": "This null check is to handle a race condition where the onSnapshotChanged() callback might have been invoked prior to this (because this gets posted, the initialization does not). One other possible way to handle this is to serialize all of the initialization on the handler thread so that the registration happens synchronously with this... it\u0027s just an unfortunate thing as-is.\n\nNote: if you think it\u0027s better to leave as-is, please add a comment describing the race.",
      "range": {
        "startLine": 204,
        "startChar": 24,
        "endLine": 204,
        "endChar": 37
      },
      "revId": "6df6005daf9fddec9ac6e085f279a3392d995c31",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
