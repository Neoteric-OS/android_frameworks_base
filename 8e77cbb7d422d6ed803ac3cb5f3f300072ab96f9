        "id": 1006497
      },
      "writtenOn": "2019-06-07T18:45:25Z",
      "side": 1,
      "message": "If this is strictly for Push-To-Talk, why isn\u0027t it just called KEYCODE_PUSH_TO_TALK?",
      "parentUuid": "c8e5f91b_af8f9aac",
      "range": {
        "startLine": 813,
        "startChar": 27,
        "endLine": 813,
        "endChar": 30
      },
      "revId": "8e77cbb7d422d6ed803ac3cb5f3f300072ab96f9",
