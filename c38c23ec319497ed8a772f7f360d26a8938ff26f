        "id": 1015428
      },
      "writtenOn": "2020-02-14T03:58:30Z",
      "side": 1,
      "message": "prepareInternal() is doing IPCs and long-running stuff. It is also called without the lock all over the place.\n\nPlease reduce the scope of this lock to what is actually necessary (and actually not dangerous)",
      "range": {
        "startLine": 2962,
        "startChar": 12,
        "endLine": 2962,
        "endChar": 24
      },
      "revId": "c38c23ec319497ed8a772f7f360d26a8938ff26f",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": true
    },
    {
      "key": {
        "uuid": "7c46e30f_fcbefc60",
        "filename": "services/core/java/com/android/server/connectivity/Vpn.java",
