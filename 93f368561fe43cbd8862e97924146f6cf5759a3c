      "writtenOn": "2021-11-18T01:33:36Z",
      "side": 1,
      "message": "Question mainly for Tyler - should we be defining these little AIDL data classes in their own AIDL files or nested inside ITelephony?",
      "range": {
        "startLine": 27,
        "startChar": 0,
        "endLine": 27,
        "endChar": 35
      },
      "revId": "93f368561fe43cbd8862e97924146f6cf5759a3c",
