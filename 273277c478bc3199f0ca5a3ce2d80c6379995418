        "id": 1074459
      },
      "writtenOn": "2024-11-05T21:07:38Z",
      "side": 1,
      "message": "I don\u0027t think this is a well defined to surface to even wallet app. What is wallet going to do with this info?",
      "range": {
        "startLine": 1131,
        "startChar": 0,
        "endLine": 1142,
        "endChar": 0
      },
      "revId": "273277c478bc3199f0ca5a3ce2d80c6379995418",
