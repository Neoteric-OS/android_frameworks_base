    },
    {
      "unresolved": true,
      "key": {
        "uuid": "711f68b3_f6d230dc",
        "filename": "nfc/java/android/nfc/cardemulation/CardEmulation.java",
        "patchSetId": 21
      },
      "lineNbr": 1123,
      "author": {
        "id": 1986287
      },
      "writtenOn": "2024-11-05T21:16:53Z",
      "side": 1,
      "message": "The idea is that the Event Listener API is a lighter-weight interface to important NFC-related events. Knowing that the NFC controller was turned off seems important and this keeps all the notifications in the same place. This also provides more accurate timing of this event, as one doesn\u0027t need to go through the whole Broadcast infrastructure for it.\n\nThat said, you\u0027re right: it exists already as a broadcast and we don\u0027t *need* it. It just feels like a nice-to-have for this new interface.",
      "parentUuid": "ce81d5c1_b00fd83e",
      "range": {
        "startLine": 1123,
        "startChar": 21,
        "endLine": 1123,
        "endChar": 38
      },
      "revId": "273277c478bc3199f0ca5a3ce2d80c6379995418",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "9b77deb0_955047dd",
        "filename": "nfc/java/android/nfc/cardemulation/CardEmulation.java",
        "patchSetId": 21
      },
      "lineNbr": 1129,
      "author": {
        "id": 1074459
      },
      "writtenOn": "2024-11-05T21:07:38Z",
      "side": 1,
      "message": "how are we going to report this if the NFC stack crashes? There is no way for us to report this if the NFC stack restarts.",
      "range": {
        "startLine": 1129,
        "startChar": 21,
        "endLine": 1129,
        "endChar": 38
      },
      "revId": "273277c478bc3199f0ca5a3ce2d80c6379995418",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": true,
