      "writtenOn": "2024-11-05T21:07:38Z",
      "side": 1,
      "message": "why do we need this? there is already a 3p broadcast for this.",
      "range": {
        "startLine": 1123,
        "startChar": 21,
        "endLine": 1123,
        "endChar": 38
      },
      "revId": "273277c478bc3199f0ca5a3ce2d80c6379995418",
