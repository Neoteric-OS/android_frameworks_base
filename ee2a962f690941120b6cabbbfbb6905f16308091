      "writtenOn": "2021-08-25T17:57:20Z",
      "side": 1,
      "message": "The integer we are reading may be maliciously constructed here. If it is too large, this will result in an abort. Being beyond the bounds of the Parcel, it may also abort or cause a later error.",
      "range": {
        "startLine": 3371,
        "startChar": 0,
        "endLine": 3371,
        "endChar": 53
      },
      "revId": "ee2a962f690941120b6cabbbfbb6905f16308091",
