        "id": 1221725
      },
      "writtenOn": "2018-01-22T19:14:46Z",
      "side": 1,
      "message": "Created a bug tracking this: b/72316676. I\u0027ll make sure to address this with a CL addressing the netd-call todos.",
      "parentUuid": "1c186f49_66d7dec0",
      "range": {
        "startLine": 1196,
        "startChar": 8,
        "endLine": 1196,
        "endChar": 38
      },
      "revId": "40b4bf1534b39f3811b88fa23b68db66e445077a",
