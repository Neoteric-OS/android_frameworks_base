      },
      "writtenOn": "2018-01-22T14:16:55Z",
      "side": 1,
      "message": "I thought we had agreed that adding and removing addresses would be up to telephony code.",
      "range": {
        "startLine": 49,
        "startChar": 0,
        "endLine": 55,
        "endChar": 30
      },
      "revId": "40b4bf1534b39f3811b88fa23b68db66e445077a",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": true
