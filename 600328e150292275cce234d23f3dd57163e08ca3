        "id": 1059882
      },
      "writtenOn": "2021-08-12T22:53:49Z",
      "side": 1,
      "message": "Hm...  okay, but note that we are already violating that above where if the entire Bundle hasn\u0027t been unparceled yet, we make a copy of the parcel.",
      "parentUuid": "6a3fb644_662013fa",
      "range": {
        "startLine": 498,
        "startChar": 0,
        "endLine": 498,
        "endChar": 89
      },
      "revId": "600328e150292275cce234d23f3dd57163e08ca3",
