      "writtenOn": "2020-01-29T16:16:53Z",
      "side": 1,
      "message": "the default also listens for TRUSTED networks.\nJust pointing out to see whether you want to restrict the scope of the NetworkRequest to trusted networks, else this could potentially also run on top of untrusted networks (which do not become default in today\u0027s world) when a trusted network (say Cell) is available.",
      "range": {
        "startLine": 2218,
        "startChar": 26,
        "endLine": 2218,
        "endChar": 33
      },
      "revId": "dec7a71afe933a74927c1238919400de647b57d0",
