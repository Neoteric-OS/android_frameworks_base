        "patchSetId": 3
      },
      "lineNbr": 65,
      "author": {
        "id": 1021495
      },
      "writtenOn": "2013-11-27T15:57:18Z",
      "side": 1,
      "message": "Created android.telephony.DisconnectCause with DISCONNECT_CAUSE_* constants.\nCreated android.telephony.PreciseDisconnectCause with PRECISE_DISCONNECT_CAUSE_* constants.\nRemoved constants from android.telephony.PreciseCallState",
      "parentUuid": "1e78816e_b61228b2",
      "revId": "363ba26d67734701f5017109913b2053a408eb99",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": false
