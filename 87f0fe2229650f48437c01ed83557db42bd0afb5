      "writtenOn": "2024-11-19T10:43:31Z",
      "side": 1,
      "message": "Is there a reason why the audio manager is not available on system ready in this device? Maybe we should use `AudioManagerInternal` instead, since we use the internal ringer mode anyways?",
      "range": {
        "startLine": 239,
        "startChar": 54,
        "endLine": 239,
        "endChar": 56
      },
      "revId": "87f0fe2229650f48437c01ed83557db42bd0afb5",
