        </td>
      </tr>
      <tr>
        <td>bool rsIsObject(<a href='rs_graphics.html#android_rs:rs_program_store'>rs_program_store</a> v);
</td>
        <td>    When compiling for 32 bits. 
        </td>
      </tr>
      <tr>
