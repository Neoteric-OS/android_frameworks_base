java_library_static {
    name: "framework-protos",
    host_supported: true,
    proto: {
        type: "nano",
    },
    srcs: ["./**/*.proto"],
    no_framework_libs: true,
    // Pin java_version until jarjar is certified to support later versions. http://b/72703434
    java_version: "1.8",
    target: {
        android: {
            jarjar_rules: "jarjar-rules.txt",
        },
        host: {
            static_libs: ["libprotobuf-java-nano"],
        },
    },
}

java_library_static {
    name: "bluetooth-metrics-protos-lite",
    host_supported: true,
    proto: {
        type: "lite",
    },
    srcs: ["android/bluetooth/bluetooth.proto"],
}

cc_library_static {
    name: "libbt-metrics-proto-lite",
    srcs: ["android/bluetooth/bluetooth.proto"],
    proto: {
        export_proto_headers: true,
        type: "lite",
    },
    host_supported: true,
}
