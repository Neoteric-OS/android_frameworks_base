java_library_static {
    name: "framework-protos",
    proto: {
        type: "nano",
    },
    srcs: ["src/**/*.proto"],
    jarjar_rules: "jarjar-rules.txt",

    no_framework_libs: true,
    sdk_version: "9",

    // Pin java_version until jarjar is certified to support later versions. http://b/72703434
    java_version: "1.8",
}

java_library_host {
    name: "framework-protos-host",
    proto: {
        type: "nano",
    },
    srcs: ["src/**/*.proto"],
    static_libs: ["host-libprotobuf-java-nano"],
}
