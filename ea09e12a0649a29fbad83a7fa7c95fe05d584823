    },
    {
      "key": {
        "uuid": "50dbd705_5f5db724",
        "filename": "location/java/com/android/internal/location/GpsNetInitiatedHandler.java",
        "patchSetId": 9
      },
      "lineNbr": 146,
      "author": {
        "id": 1049138
      },
      "writtenOn": "2014-09-04T22:09:29Z",
      "side": 1,
      "message": "mIsInEmergency will be set to true here if it is a emergency call, and when the emergency call hang up, the phone status listener (mPhoneStateListener) will set it to false. \n\nNext time, when we call home,  mIsInEmergency will stay with false, and then when the home call ends, the  mIsInEmergency will be set to false again by mPhoneStateListener, even though it did not have a chance to be set to true.",
      "parentUuid": "50dbd705_246f8a0c",
      "range": {
        "startLine": 146,
        "startChar": 16,
        "endLine": 146,
        "endChar": 30
      },
      "revId": "ea09e12a0649a29fbad83a7fa7c95fe05d584823",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": false
    },
    {
