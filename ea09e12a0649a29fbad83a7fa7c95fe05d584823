    {
      "key": {
        "uuid": "50dbd705_246f8a0c",
        "filename": "location/java/com/android/internal/location/GpsNetInitiatedHandler.java",
        "patchSetId": 9
      },
      "lineNbr": 146,
      "author": {
        "id": 1036868
      },
      "writtenOn": "2014-09-04T21:58:56Z",
      "side": 1,
      "message": "You use \u0027|\u003d\u0027 here, so once it gets set, it will always be true.\n\nBut if you change it to \u0027\u003d\u0027, that mean device will be out of emergency mode once it is used to dial other number (say call home). Is this the expected behavior?\n\nAre we really clear about how the mIsInEmergency should be defined?",
      "parentUuid": "10807fc3_939b3321",
      "range": {
        "startLine": 146,
        "startChar": 16,
        "endLine": 146,
        "endChar": 30
      },
      "revId": "ea09e12a0649a29fbad83a7fa7c95fe05d584823",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
