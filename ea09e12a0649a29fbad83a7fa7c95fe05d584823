      },
      "writtenOn": "2014-09-04T18:19:04Z",
      "side": 1,
      "message": "Shouldn\u0027t this be false? In fact, why not move the check inside handleNiInEs(), and you can just call that function directly from here.",
      "range": {
        "startLine": 207,
        "startChar": 32,
        "endLine": 207,
        "endChar": 36
      },
      "revId": "ea09e12a0649a29fbad83a7fa7c95fe05d584823",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": false
    },
    {
      "key": {
        "uuid": "30e023af_7832157c",
        "filename": "location/java/com/android/internal/location/GpsNetInitiatedHandler.java",
