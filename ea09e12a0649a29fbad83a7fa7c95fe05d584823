      },
      "writtenOn": "2014-09-04T18:19:04Z",
      "side": 1,
      "message": "I found the comment and the overall logic is quite confusing here. Do you mean you won\u0027t ignore emergency SUPL INIT when ES bit is off and UE is not in emergency?",
      "range": {
        "startLine": 272,
        "startChar": 0,
        "endLine": 272,
        "endChar": 64
      },
      "revId": "ea09e12a0649a29fbad83a7fa7c95fe05d584823",
