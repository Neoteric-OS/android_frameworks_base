    {
      "key": {
        "uuid": "50dbd705_d69f54d9",
        "filename": "location/java/com/android/internal/location/GpsNetInitiatedHandler.java",
        "patchSetId": 9
      },
      "lineNbr": 272,
      "author": {
        "id": 1049138
      },
      "writtenOn": "2014-09-04T20:23:42Z",
      "side": 1,
      "message": "Enriched the comments in next patch as followed: \n        \n/*\n1. When SUPL ES bit is off and UE is not in emergency mode: Call handleNi() to do legacy behavior.\n\n2. When SUPL ES bit is on and UE is in emergency mode: Call handleNi() to do acceptance behavior.\n\n3. When SUPL ES bit is off but UE is in emergency mode: Ignore the emergency SUPL INIT.\n\n4. When SUPL ES bit is on but UE is not in emergency mode: Ignore the emergency SUPL INIT.\n*/",
      "parentUuid": "30e023af_4fbc2dc6",
