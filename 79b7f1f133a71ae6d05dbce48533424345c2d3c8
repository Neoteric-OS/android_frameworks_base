      "writtenOn": "2022-01-10T18:12:58Z",
      "side": 1,
      "message": "Yeah, but this is just how the txt files work: system-current.txt does not include current.txt (it didn\u0027t before this \"merged\" build rule existed, so I didn\u0027t include it afterward either)",
      "parentUuid": "690deafa_198d4665",
      "revId": "79b7f1f133a71ae6d05dbce48533424345c2d3c8",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
