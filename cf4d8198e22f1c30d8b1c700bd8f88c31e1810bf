    {
      "key": {
        "uuid": "12321c03_fa4672e6",
        "filename": "services/core/java/com/android/server/ConnectivityService.java",
        "patchSetId": 3
      },
      "lineNbr": 4849,
      "author": {
        "id": 1000835
      },
      "writtenOn": "2019-01-07T09:42:04Z",
      "side": 1,
      "message": "Per in-person: we should probably do this before we call nai.asyncChannel.connect(). This is so that if we get a message from the NetworkAgent that would cause us to ask NetworkMonitor to do something, we\u0027d send a message to a state machine that is not yet started, and it would crash.",
      "range": {
        "startLine": 4848,
        "startChar": 0,
        "endLine": 4849,
        "endChar": 34
      },
      "revId": "cf4d8198e22f1c30d8b1c700bd8f88c31e1810bf",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": true
    },
    {
      "key": {
        "uuid": "f69fa617_de99f475",
        "filename": "services/core/java/com/android/server/ConnectivityService.java",
        "patchSetId": 3
      },
      "lineNbr": 5782,
      "author": {
        "id": 1000835
      },
      "writtenOn": "2019-01-07T09:42:04Z",
      "side": 1,
      "message": "We need to ensure that the ordering of this message with respect to notifyLinkPropertiesChanged is correct. As soon as NetworkMonitor receives this one, it will enter EvaluatingState and fetch the LinkProperties. If we haven\u0027t already sent it notifyLinkPropertiesChanged, then it could use the wrong LinkProperties.\n\nLooks like the code is correct now, but we might want to add a comment explaining that we must only send the connect command after updating the LinkProperties.",
      "range": {
        "startLine": 5782,
        "startChar": 44,
        "endLine": 5782,
        "endChar": 66
      },
      "revId": "cf4d8198e22f1c30d8b1c700bd8f88c31e1810bf",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": true
    },
