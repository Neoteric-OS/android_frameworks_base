      "writtenOn": "2019-01-07T09:42:04Z",
      "side": 1,
      "message": "This comment should explain what happens if the network disconnects or sends any other event before the NetworkMonitor arrives. This is not a problem, because nothing can arrive from the NetworkAgent until we call nai.asyncChannel.connect(), which only happens when we call handlerRegisterNetworkAgent.",
      "range": {
        "startLine": 4823,
        "startChar": 0,
        "endLine": 4823,
        "endChar": 97
      },
      "revId": "cf4d8198e22f1c30d8b1c700bd8f88c31e1810bf",
