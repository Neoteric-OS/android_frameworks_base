      },
      "writtenOn": "2020-05-12T17:19:13Z",
      "side": 1,
      "message": "If we remove this from the defaults and add it to the individual java_sdk_libraries instead it allows cleanup one-by-one without littering the individual rules with the default naming scheme.",
      "range": {
        "startLine": 84,
        "startChar": 0,
        "endLine": 87,
        "endChar": 39
      },
      "revId": "bbe4403d3de1feab49d7377d388482ad8cf747f2",
