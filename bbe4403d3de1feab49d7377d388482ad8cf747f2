    {
      "key": {
        "uuid": "b51925af_1f320af9",
        "filename": "apex/Android.bp",
        "patchSetId": 9
      },
      "lineNbr": 87,
      "author": {
        "id": 1039338
      },
      "writtenOn": "2020-05-13T12:35:57Z",
      "side": 1,
      "message": "I\u0027m hoping to avoid having any dependencies on the internal structure of the java_sdk_library components. It is an implementation detail that should never have been relied upon by anything.\n\nThe advantage of hiding it is that it gives us a lot more flexibility in how we generate the different API surfaces. e.g. We could replace three (or even 4 with module_lib) invocations of droidstubs with one that generates all API surfaces in one go. That is impossible in the current situation because of direct dependencies on the internals.\n\nIn that case we won\u0027t be migrating from the framework-modules naming scheme to default naming scheme we will be migrating from the framework-modules naming scheme to references to the java_sdk_library directly.\n\nI\u0027ve just found that ike is using java_sdk_library for public/system and then separate modules for module_lib using the default naming scheme so it will be easier to handle that as you suggested by adding this in the individual modules.",
      "parentUuid": "b830cc69_026e7f02",
      "range": {
        "startLine": 84,
        "startChar": 0,
        "endLine": 87,
        "endChar": 39
      },
      "revId": "bbe4403d3de1feab49d7377d388482ad8cf747f2",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": false
    },
