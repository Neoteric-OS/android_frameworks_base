      },
      "writtenOn": "2023-08-11T15:54:15Z",
      "side": 1,
      "message": "That fixes the returns down here, but not up top.",
      "parentUuid": "21524a1e_74fae709",
      "revId": "95b105671e5eb57434303088a0291b81e8de1372",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
