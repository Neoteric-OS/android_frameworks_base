<resources>

    <!--
        Base application theme, dependent on API level. This theme is replaced
        by AppBaseTheme from res/values-vXX/styles.xml on newer devices.
    -->
    <style name="AppBaseTheme" parent="@android:style/Theme.Material.Light">
        <!--
            Theme customizations available in newer API levels can go in
            res/values-vXX/styles.xml, while customizations related to
            backward-compatibility can go here.
        -->
    </style>

    <!-- Application theme. -->
    <style name="AppTheme" parent="AppBaseTheme">
        <!-- All customizations that are NOT specific to a particular API-level can go here. -->
        <!-- Setting's theme's accent color makes ProgressBar useless, reset back. -->
        <item name="android:actionBarStyle">@style/AppActionBar</item>
    </style>

    <style name="AppActionBar" parent="@android:style/Theme.Material.Light">
      <item name="android:displayOptions">showTitle</item>
      <item name="android:textColorPrimary">@android:color/black</item>
      <item name="android:textColorSecondary">@android:color/white</item>
      <item name="android:paddingTop">4dp</item>
      <item name="android:paddingBottom">6dp</item>
    </style>

</resources>
