package {
    default_team: "trendy_team_enigma",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

filegroup {
    name: "framework-vcn-updatable-sources",
    defaults: ["framework-sources-module-defaults"],
    srcs: [
        "src/**/*.java",
        "src/**/*.aidl",
        ":framework-vcn-util-sources", // PersistableBundlerUtil
        ":framework-connectivity-shared-srcs", // IndentingPrintWriter
    ],
    visibility: ["//frameworks/base/packages/Vcn:__subpackages__"],
}

filegroup {
    name: "ike-params-parser-sources",
    srcs: [
        "src/android/net/vcn/persistablebundleutils/**/*.java",
    ],
    path: "src",
    visibility: [
        "//frameworks/base",
    ],
}

filegroup {
    name: "vcn-jarjar-rules-sources",
    srcs: [
        "vcn-jarjar-rules.txt",
    ],
    visibility: ["//frameworks/base/packages/Vcn:__subpackages__"],
}

java_defaults {
    name: "framework-vcn-defaults",
    sdk_version: "module_current",
    min_sdk_version: "35", // TODO: Make it Android 25Q2 when this is included in mainline
    defaults: ["framework-module-defaults"], // This is a boot jar

    srcs: [
        ":framework-vcn-updatable-sources",
    ],

    libs: [
        "android.net.ipsec.ike.stubs.module_lib",
        "androidx.annotation_annotation",
        "app-compat-annotations",
        "framework-wifi.stubs.module_lib",
        "unsupportedappusage",
    ],
    static_libs: [
         "android.net.vcn.flags-aconfig-java",
         "net-utils-framework-common", // BinderUtils
    ],
    aidl: {
        generate_get_transaction_name: true, // Do we need to generate GetTransaction?
        include_dirs: [
            // For connectivity-framework classes such as Network.aidl, NetworkCapabilities.aidl
            "packages/modules/Connectivity/framework/aidl-export",
        ],
    },

    // TODO: provide api prebuilts and remove this flag.
    // unsafe_ignore_missing_latest_api: true,
}

java_sdk_library {
    name: "framework-vcn",
    defaults: [
        "framework-vcn-defaults",
    ],
    jarjar_rules: ":vcn-jarjar-rules-sources",

    permitted_packages: [
        "android.net.vcn",
        "android.net",
        "android.util",
        "com.android.internal.util",
        "com.android.modules.utils",
        "com.android.net.module.util",
        "com.android.server.vcn",
        
    ],
    api_packages: [
        "android.net.vcn",
    ],

    // Allow VCN APIs to reference APIs in IKE and Connectivity
    stub_only_libs: [
        "android.net.ipsec.ike.stubs.module_lib",
        "framework-connectivity.stubs.module_lib",
    ],
    libs: [
        "framework-connectivity.stubs.module_lib",
    ],
    impl_only_libs: [
        "framework-connectivity-pre-jarjar",
    ],

    impl_library_visibility: [
        "//packages/modules/Connectivity/service",
        "//packages/modules/Connectivity/service-w",
    ],
}

java_library {
    name: "framework-vcn-pre-jarjar",
    defaults: ["framework-vcn-defaults"],
    libs: [
        "framework-connectivity-pre-jarjar",
    ],

    visibility: ["//frameworks/base/packages/Vcn:__subpackages__"],
}
