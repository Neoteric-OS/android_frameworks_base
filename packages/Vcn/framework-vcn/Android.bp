package {
    default_team: "trendy_team_enigma",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

filegroup {
    name: "vcn-aidl-export-sources",
    path: "aidl-export",
    srcs: [
        "aidl-export/**/*.aidl",
    ],
}

filegroup {
    name: "framework-vcn-updatable-sources",
    defaults: ["framework-sources-module-defaults"],
    srcs: [
        "src/**/*.java",
        ":vcn-aidl-export-sources",
        ":framework-vcn-util-sources", // PersistableBundlerUtil
    ],

    visibility: [
        "//frameworks/base/packages/Vcn:__subpackages__",
    ],
}

filegroup {
    name: "ike-params-parser-sources",
    srcs: [
        "src/android/net/vcn/persistablebundleutils/**/*.java",
    ],
    path: "src",
    visibility: [
        "//frameworks/base", // For usage in Vpn.java
    ],
}

java_defaults {
    name: "framework-vcn-defaults",
    sdk_version: "module_current",
    min_sdk_version: "35", // TODO: Make it Android 25Q2 when this is included in mainline
    defaults: ["framework-module-defaults"], // This is a boot jar

    srcs: [
        ":framework-vcn-updatable-sources",
    ],

    libs: [
        "android.net.ipsec.ike.stubs.module_lib",
        "app-compat-annotations",
        "framework-wifi.stubs.module_lib",
        "unsupportedappusage",
    ],
    static_libs: [
        "android.net.vcn.flags-aconfig-java",
    ],
    aidl: {
        include_dirs: [
            // For connectivity-framework classes such as Network.aidl, NetworkCapabilities.aidl
            "packages/modules/Connectivity/framework/aidl-export",
        ],
    },
}

java_sdk_library {
    name: "framework-vcn",
    defaults: [
        "framework-vcn-defaults",
    ],

    jarjar_rules: "framework-vcn-jarjar-rules.txt",

    permitted_packages: [
        "android.net.vcn",
        "com.android.server.vcn.util",

    ],
    api_packages: [
        "android.net.vcn",
    ],

    // Allow VCN APIs to reference APIs in IKE and Connectivity
    stub_only_libs: [
        "android.net.ipsec.ike.stubs.module_lib",
        "framework-connectivity.stubs.module_lib",
    ],

    // To use non-jarjard names of utilities such as android.util.IndentingPrintWriter
    impl_only_libs: [
        "framework-connectivity-pre-jarjar",
    ],

    aconfig_declarations: [
        "android.net.vcn.flags-aconfig-java",
    ],

    impl_library_visibility: [
        // Using for test only
        "//cts/tests/netlegacy22.api",
        "//frameworks/base/core/tests/bandwidthtests",
        "//frameworks/base/core/tests/benchmarks",
        "//frameworks/base/core/tests/utillib",
        "//frameworks/base/tests/vcn",
        "//frameworks/opt/telephony/tests/telephonytests",
        "//packages/modules/CaptivePortalLogin/tests",
        "//packages/modules/Connectivity/Tethering/tests/integration",
        "//packages/modules/Connectivity/Tethering/tests/mts",
        "//packages/modules/Connectivity/staticlibs/testutils",
        "//packages/modules/Connectivity/thread/tests/cts",
        "//packages/modules/Connectivity/thread/tests/integration",
        "//packages/modules/Connectivity/thread/tests/utils",
        "//packages/modules/Connectivity/staticlibs/tests/unit",
        "//packages/modules/Connectivity/tests/cts/hostside/app",
        "//packages/modules/Connectivity/tests/cts/multidevices/snippet",
        "//packages/modules/Connectivity/tests/cts/net",
        "//packages/modules/Connectivity/tests/cts/netpermission/updatestatspermission",
        "//packages/modules/Connectivity/tests/integration",
        "//packages/modules/IPsec/tests/iketests",
        "//packages/modules/NetworkStack/tests/integration",
        "//packages/modules/NetworkStack/tests/unit",
    ],
}

java_library {
    name: "framework-vcn-pre-jarjar",
    defaults: ["framework-vcn-defaults"],
    libs: [
        "framework-connectivity-pre-jarjar",
    ],
}
