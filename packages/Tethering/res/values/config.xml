<resources>
    <!--
    OEMs that wish to change the below settings must do so via a runtime resource overlay package
    and *NOT* by changing this file. This file is part of the tethering mainline module.
    TODO: define two resources for each config item: a default_* resource and a config_* resource,
    config_* is empty by default but may be overridden by RROs.
    -->
    <!-- List of regexpressions describing the interface (if any) that represent tetherable
         USB interfaces.  If the device doesn't want to support tethering over USB this should
         be empty.  An example would be "usb.*" -->
    <string-array translatable="false" name="config_tether_usb_regexs">
        <item>"usb\\d"</item>
        <item>"rndis\\d"</item>
    </string-array>

    <!-- List of regexpressions describing the interface (if any) that represent tetherable
         NCM interfaces.  If the device doesn't want to support tethering over NCM this should
         be empty. -->
    <string-array translatable="false" name="config_tether_ncm_regexs">
    </string-array>

    <!-- List of regexpressions describing the interface (if any) that represent tetherable
         Wifi interfaces.  If the device doesn't want to support tethering over Wifi this
         should be empty.  An example would be "softap.*" -->
    <string-array translatable="false" name="config_tether_wifi_regexs">
        <item>"wlan\\d"</item>
        <item>"softap\\d"</item>
    </string-array>

    <!-- List of regexpressions describing the interface (if any) that represent tetherable
         Wifi P2P interfaces.  If the device doesn't want to support tethering over Wifi P2p this
         should be empty.  An example would be "p2p-p2p.*" -->
    <string-array translatable="false" name="config_tether_wifi_p2p_regexs">
    </string-array>

    <!-- List of regexpressions describing the interface (if any) that represent tetherable
         bluetooth interfaces.  If the device doesn't want to support tethering over bluetooth this
         should be empty. -->
    <string-array translatable="false" name="config_tether_bluetooth_regexs">
        <item>"bt-pan"</item>
    </string-array>

    <!-- Use the old dnsmasq DHCP server for tethering instead of the framework implementation. -->
    <bool translatable="false" name="config_tether_enable_legacy_dhcp_server">false</bool>

    <!-- Dhcp range (min, max) to use for tethering purposes -->
    <string-array translatable="false" name="config_tether_dhcp_range">
    </string-array>

    <!-- Array of ConnectivityManager.TYPE_{BLUETOOTH, ETHERNET, MOBILE, MOBILE_DUN, MOBILE_HIPRI,
         WIFI} values allowable for tethering.

         Common options are [1, 4] for TYPE_WIFI and TYPE_MOBILE_DUN or
         [1,7,0] for TYPE_WIFI, TYPE_BLUETOOTH, and TYPE_MOBILE.

         This list is also modified by code within the framework, including:

             - TYPE_ETHERNET (9) is prepended to this list, and

             - the return value of TelephonyManager.isTetheringApnRequired()
               determines how the array is further modified:

                   * TRUE (DUN REQUIRED).
                     TYPE_MOBILE is removed (if present).
                     TYPE_MOBILE_HIPRI is removed (if present).
                     TYPE_MOBILE_DUN is appended (if not already present).

                   * FALSE (DUN NOT REQUIRED).
                     TYPE_MOBILE_DUN is removed (if present).
                     If both of TYPE_MOBILE{,_HIPRI} are not present:
                        TYPE_MOBILE is appended.
                        TYPE_MOBILE_HIPRI is appended.

         For other changes applied to this list, now and in the future, see
         com.android.server.connectivity.tethering.TetheringConfiguration.

         Note also: the order of this is important. The first upstream type
         for which a satisfying network exists is used.
    -->
    <integer-array translatable="false" name="config_tether_upstream_types">
    </integer-array>

    <!-- When true, the tethering upstream network follows the current default
         Internet network (except when the current default network is mobile,
         in which case a DUN network will be used if required).

         When true, overrides the config_tether_upstream_types setting above.
    -->
    <bool translatable="false" name="config_tether_upstream_automatic">true</bool>


    <!-- If the mobile hotspot feature requires provisioning, a package name and class name
         can be provided to launch a supported application that provisions the devices.
         EntitlementManager will send an intent to Settings with the specified package name and
         class name in extras to launch provision app.
         TODO: note what extras here.

         See EntitlementManager#runUiTetherProvisioning and
         packages/apps/Settings/src/com/android/settings/network/TetherProvisioningActivity.java
         for more details.

         For ui-less/periodic recheck support see config_mobile_hotspot_provision_app_no_ui
        -->
    <!-- The first element is the package name and the second element is the class name
         of the provisioning app -->
    <string-array translatable="false" name="config_mobile_hotspot_provision_app">
    <!--
        <item>com.example.provisioning</item>
        <item>com.example.provisioning.Activity</item>
    -->
    </string-array>

    <!-- If the mobile hotspot feature requires provisioning, an action can be provided
         that will be broadcast in non-ui cases for checking the provisioning status.
         EntitlementManager will pass the specified name to Settings and Settings would
         launch provisioning app by sending an intent with the package name.

         A second broadcast, action defined by config_mobile_hotspot_provision_response,
         will be sent back to notify if provisioning succeeded or not.  The response will
         match that of the activity in config_mobile_hotspot_provision_app, but instead
         contained within the int extra "EntitlementResult".
         TODO: provide the system api for "EntitlementResult" extra and note it here.

         See EntitlementManager#runSilentTetherProvisioning and
         packages/apps/Settings/src/com/android/settings/wifi/tether/TetherService.java for more
         details.
        -->
    <string translatable="false" name="config_mobile_hotspot_provision_app_no_ui"></string>

    <!-- Sent in response to a provisioning check. The caller must hold the
         permission android.permission.TETHER_PRIVILEGED for Settings to
         receive this response.

         See config_mobile_hotspot_provision_response
         -->
    <string translatable="false" name="config_mobile_hotspot_provision_response"></string>

    <!-- Number of hours between each background provisioning call -->
    <integer translatable="false" name="config_mobile_hotspot_provision_check_period">24</integer>

    <!-- ComponentName of the service used to run no ui tether provisioning. -->
    <string translatable="false" name="config_wifi_tether_enable">com.android.settings/.wifi.tether.TetherService</string>

    <!-- Default tethering notification -->
    <!-- Icons for showing tether enable notification.
         Each item should have two elements and separate with ";".

         The front element is downstream types which is one of tethering. This element has to be
         made by WIFI, USB, BT, and OR'd with the others. Use "|" to combine multiple downstream
         types and use "," to separate each combinations. Such as

             USB|BT,WIFI|USB|BT

         The end element is icon for the downstream types. This element has to be composed by
         <package name>:<resource type>/<resource name>. Such as

             1. com.android.networkstack.tethering:drawable/stat_sys_tether_general
             2. android:drawable/xxx

         So the entire string of each item would be

             USB|BT,WIFI|USB|BT;com.android.networkstack.tethering:drawable/stat_sys_tether_general

         Notification will not show if the downstream type doesn't list in array. Empty array means
         disable all notifications. -->
    <!-- Hotspot doesn't show notification due to status bar already has an icon -->
    <string-array translatable="false" name="tethering_notification_icons">
        <item>USB;com.android.networkstack.tethering:drawable/stat_sys_tether_usb</item>
        <item>BT;com.android.networkstack.tethering:drawable/stat_sys_tether_bluetooth</item>
        <item>WIFI|USB,WIFI|BT;com.android.networkstack.tethering:drawable/stat_sys_tether_general</item>
        <item>USB|BT,WIFI|USB|BT;com.android.networkstack.tethering:drawable/stat_sys_tether_general</item>
    </string-array>
    <!-- String for tether enable notification title.
         Add "%1$s" into string if you'd like to show downstream combinations info. Such as

             %1$s tethering on.

         Then if set combinations info to "Hotspot, USB, Bluetooth", the string after combined
         downstream combinations info would be

             Hotspot, USB, Bluetooth tethering on.
    -->
    <string name="tethering_notification_title">@string/tethered_notification_title</string>
    <!-- String for tether enable notification message.
         Add "%1$s" into string if you'd like to show downstream combinations info. Such as

             Tap to set up %1$s tethering.

         Then if set combinations info to "Hotspot, USB, Bluetooth", the string after combined
         downstream combinations info would be

             Tap to set up Hotspot, USB, Bluetooth tethering.
    -->
    <string name="tethering_notification_message">@string/tethered_notification_message</string>
    <!-- String for tether enable notification message when power saving mode is on.
         Add "%1$s" into string if you'd like to show downstream combinations info. Such as

             Tap to set up %1$s tethering. Power saving on.

         Then if set combinations info to "Hotspot, USB, Bluetooth", the string after combined
         downstream combinations info would be

             Tap to set up Hotspot, USB, Bluetooth tethering. Power saving on.
    -->
    <string name="tethering_notification_message_power_saving">@string/tethered_notification_message</string>
    <!-- Strings for downstream combinations info.
         Each item should have two elements and separate with ";".

         The first element is downstream types which is one of tethering. This element has to be
         made by WIFI, USB, BT, and OR'd with the others. Use "|" to combine multiple downstream
         types and use "," to separate each combinations. Such as

             USB|BT,WIFI|USB|BT

         The second element is string for the item. Such as

             Hotspot, USB, Bluetooth

         So the entire string of each item would be

             WIFI|USB|BT;Hotspot, USB, Bluetooth

         Please also configure tethering_notification_title and tethering_notification_message if
         set any item here. Otherwise the combinations info wouldn't be contained in notification
         title or message. -->
    <string-array name="tethering_downstream_combinations">
    </string-array>

    <!-- Tethering notification with connected client number. -->
    <!-- Icons for showing tether enable notification with client number info.
         Each item should have two elements and separate with ";".

         The first element is client number. Such as 1,2,3,4,5...

         The second element is icon for the number. This element has to be composed by
         <package name>:<resource type>/<resource name>. Such as

             1. com.android.networkstack.tethering:drawable/stat_sys_tether_number_one
             2. android:drawable/xxx

         So the entire string of each item would be

             1;com.android.networkstack.tethering:drawable/stat_sys_tether_number_one

         Will not show default notification w/o client number if the client number doesn't list in
         array. Empty array means disable this kind of notification. -->
    <string-array translatable="false" name="tethering_notification_icons_with_client">
    </string-array>
    <!-- String for tether enable notification title with client number info.
         Basically, this config should have two items. One for single client and one for multiple
         clients. Add "%2$d" into string if you'd like to show client number info. Such as

             Hotspot active with %2$d devices connected.

         So the entire config with client number info would be

             <item quantity="one">Hotspot active with 1 device connected.</item>
             <item quantity="other">Hotspot active with %2$d devices connected.</item>
    -->
    <plurals name="tethering_notification_title_with_client">
    </plurals>
    <!-- Strings for tether enable notification message with client number info.
         Basically, this config should have two items. One for single client and one for multiple
         clients. Add "%2$d" into string if you'd like to show client number info. Such as

             %2$d devices connected. Tap to set up.

         So the entire config with client number info would be

             <item quantity="one">1 device connected. Tap to set up.</item>
             <item quantity="other">%2$d devices connected. Tap to set up.</item>
    -->
    <plurals name="tethering_notification_message_with_client">
    </plurals>
    <!-- Strings for tether enable notification message with client number info when power saving
         mode is on.
         Basically, this config should have two items. One for single client and one for multiple
         clients. Add "%2$d" into string if you'd like to show client number info. Such as

             %2$d devices connected. Tap to set up. Power saving on.

         So the entire config with client number info would be

             <item quantity="one">1 device connected. Tap to set up. Power saving on.</item>
             <item quantity="other">%2$d devices connected. Tap to set up. Power saving on.</item>
    -->
    <plurals name="tethering_notification_message_with_client_power_saving">
    </plurals>

    <!-- Tethering pause notification is shown when upstream network is suspended such as SRLTE call
         is in progress. -->
    <!-- Icons for showing tether pause notification.
         Each item should have two elements and separate with ";".

         The first element is downstream types which is one of tethering. This element has to be
         made by WIFI, USB, BT, and OR'd with the others. Use "|" to combine multiple downstream
         types and use "," to separate each combinations. Such as

             USB|BT,WIFI|USB|BT

         The second element is icon for the number. This element has to be composed by
         <package name>:<resource type>/<resource name>. Such as

             1. com.android.networkstack.tethering:drawable/stat_sys_tether_pause_general
             2. android:drawable/xxx

         So the entire string of each item would be

             WIFI|USB|BT;com.android.networkstack.tethering:drawable/stat_sys_tether_pause_general

         Will show default enable notification if the downstream doesn't config in this array.
         Empty array means disable this kind of notification. -->
    <string-array translatable="false" name="tethering_notification_pause_icons">
    </string-array>
    <!-- String for tether pause notification title -->
    <string name="tethering_notification_pause_title"></string>
    <!-- String for tether pause notification message -->
    <string name="tethering_notification_pause_message"></string>

    <!-- Upstream roaming notification is shown when upstream is cellular network and in roaming
         state. -->
    <!-- Config for showing upstream roaming notification.
         Please also configure upstream_roaming_notification_title and
         upstream_roaming_notification_message if enable this config.-->
    <bool translatable="false" name="config_upstream_roaming_notification">false</bool>
    <!-- String for upstream roaming notification title -->
    <string name="upstream_roaming_notification_title"></string>
    <!-- String for upstream roaming notification message -->
    <string name="upstream_roaming_notification_message"></string>
</resources>
