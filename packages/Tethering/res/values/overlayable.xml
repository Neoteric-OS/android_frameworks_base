<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <overlayable name="TetheringConfig">
        <policy type="product|system|vendor">
            <!-- Params from config.xml that can be overlaid -->
            <item type="array" name="config_tether_usb_regexs"/>
            <item type="array" name="config_tether_ncm_regexs" />
            <item type="array" name="config_tether_wifi_regexs"/>
            <item type="array" name="config_tether_wifi_p2p_regexs"/>
            <item type="array" name="config_tether_bluetooth_regexs"/>
            <item type="array" name="config_tether_dhcp_range"/>
            <item type="bool" name="config_tether_enable_legacy_dhcp_server"/>
            <item type="array" name="config_tether_upstream_types"/>
            <item type="bool" name="config_tether_upstream_automatic"/>
            <!-- Configuration values for tethering entitlement check -->
            <item type="array" name="config_mobile_hotspot_provision_app"/>
            <item type="string" name="config_mobile_hotspot_provision_app_no_ui"/>
            <item type="string" name="config_mobile_hotspot_provision_response"/>
            <item type="integer" name="config_mobile_hotspot_provision_check_period"/>
            <item type="string" name="config_wifi_tether_enable"/>
            <!-- Configuration values for TetheringNotificationUpdater -->
            <!-- Icons for showing tether enable notification.
            Each item should have two elements and separate with ";".

            The front element is downstream types which is one of tethering. This element has to be
            made by WIFI, USB, BT, and OR'd with the others. Use "|" to combine multiple downstream
            types and use "," to separate each combinations. Such as

            USB|BT,WIFI|USB|BT

            The end element is icon for the downstream types. This element has to be composed by
            <package name>:<resource type>/<resource name>. Such as

            1. com.android.networkstack.tethering:drawable/stat_sys_tether_general
            2. android:drawable/xxx

            So the entire string of each item would be

            USB|BT,WIFI|USB|BT;com.android.networkstack.tethering:drawable/stat_sys_tether_general

            Notification will not show if the downstream type doesn't list in array. Empty array
            means disable all notifications. -->
            <item type="array" name="tethering_notification_icons"/>
            <!-- String for tether enable notification title.
            Add "%1$s" into string if you'd like to show downstream combinations info. Such as

            %1$s tethering on.

            Then if set combinations info to "Hotspot, USB, Bluetooth", the string after combined
            downstream combinations info would be

            Hotspot, USB, Bluetooth tethering on.
            -->
            <item type="string" name="tethering_notification_title"/>
            <!-- String for tether enable notification message.
            Add "%1$s" into string if you'd like to show downstream combinations info. Such as

            Tap to set up %1$s tethering.

            Then if set combinations info to "Hotspot, USB, Bluetooth", the string after combined
            downstream combinations info would be

            Tap to set up Hotspot, USB, Bluetooth tethering.
            -->
            <item type="string" name="tethering_notification_message"/>
            <!-- String for tether enable notification message when power saving mode is on.
            Add "%1$s" into string if you'd like to show downstream combinations info. Such as

            Tap to set up %1$s tethering. Power saving on.

            Then if set combinations info to "Hotspot, USB, Bluetooth", the string after combined
            downstream combinations info would be

            Tap to set up Hotspot, USB, Bluetooth tethering. Power saving on.
            -->
            <item type="string" name="tethering_notification_message_power_saving"/>
            <!-- Strings for combination downstream info.
            Each item should have two elements and separate with ";".

            The first element is downstream types which is one of tethering. This element has to be
            made by WIFI, USB, BT, and OR'd with the others. Use "|" to combine multiple downstream
            types and use "," to separate each combinations. Such as

            USB|BT,WIFI|USB|BT

            The second element is string for the item. Such as

            Hotspot, USB, Bluetooth

            So the entire string of each item would be

            WIFI|USB|BT;Hotspot, USB, Bluetooth

            Please also configure tethering_notification_title and tethering_notification_message if
            set any item here. Otherwise the combination info wouldn't be contained in notification
            title or message. -->
            <item type="array" name="tethering_downstream_combinations"/>
            <!-- Icons for showing tether enable notification with client number info.
            Each item should have two elements and separate with ";".

            The first element is client number. Such as 1,2,3,4,5...

            The second element is icon for the number. This element has to be composed by
            <package name>:<resource type>/<resource name>. Such as

            1. com.android.networkstack.tethering:drawable/stat_sys_tether_number_one
            2. android:drawable/xxx

            So the entire string of each item would be

            1;com.android.networkstack.tethering:drawable/stat_sys_tether_number_one

            Will not show default notification w/o client number if the client number doesn't list
            in array. Empty array means disable this kind of notification. -->
            <item type="array" name="tethering_notification_icons_with_client"/>
            <!-- String for tether enable notification title with client number info.
            Basically, this config should have two items. One for single client and one for multiple
            clients. Add "%2$d" into string if you'd like to show client number info. Such as

            Hotspot active with %2$d devices connected.

            So the entire config with client number info would be

            <item quantity="one">Hotspot active with 1 device connected.</item>
            <item quantity="other">Hotspot active with %2$d devices connected.</item>
            -->
            <item type="plurals" name="tethering_notification_title_with_client"/>
            <!-- Strings for tether enable notification message with client number info.
            Basically, this config should have two items. One for single client and one for multiple
            clients. Add "%2$d" into string if you'd like to show client number info. Such as

            %2$d devices connected. Tap to set up.

            So the entire config with client number info would be

            <item quantity="one">1 device connected. Tap to set up.</item>
            <item quantity="other">%2$d devices connected. Tap to set up.</item>
            -->
            <item type="plurals" name="tethering_notification_message_with_client"/>
            <!-- Strings for tether enable notification message with client number info when power
            saving mode is on.
            Basically, this config should have two items. One for single client and one for multiple
            clients. Add "%2$d" into string if you'd like to show client number info. Such as

            %2$d devices connected. Tap to set up. Power saving on.

            So the entire config with client number info would be

            <item quantity="one">1 device connected. Tap to set up. Power saving on.</item>
            <item quantity="other">%2$d devices connected. Tap to set up. Power saving on.</item>
            -->
            <item type="plurals" name="tethering_notification_message_with_client_power_saving"/>
            <!-- Icons for showing tether pause notification.
            Each item should have two elements and separate with ";".

            The first element is downstream types which is one of tethering. This element has to be
            made by WIFI, USB, BT, and OR'd with the others. Use "|" to combine multiple downstream
            types and use "," to separate each combinations. Such as

            USB|BT,WIFI|USB|BT

            The second element is icon for the number. This element has to be composed by
            <package name>:<resource type>/<resource name>. Such as

            1. com.android.networkstack.tethering:drawable/stat_sys_tether_pause_general
            2. android:drawable/xxx

            So the entire string of each item would be

            WIFI|USB|BT;com.android.networkstack.tethering:drawable/stat_sys_tether_pause_general

            Will show default enable notification if the downstream doesn't config in this array.
            Empty array means disable this kind of notification. -->
            <item type="array" name="tethering_notification_pause_icons"/>
            <!-- String for tether pause notification title -->
            <item type="string" name="tethering_notification_pause_title"/>
            <!-- String for tether pause notification message -->
            <item type="string" name="tethering_notification_pause_message"/>
            <!-- Config for showing upstream roaming notification.
            Please also configure upstream_roaming_notification_title and
            upstream_roaming_notification_message if enable this config.-->
            <item type="bool" name="config_upstream_roaming_notification"/>
            <!-- String for upstream roaming notification title -->
            <item type="string" name="upstream_roaming_notification_title"/>
            <!-- String for upstream roaming notification message -->
            <item type="string" name="upstream_roaming_notification_message"/>
            <!-- Params from config.xml that can be overlaid -->

            <!-- Params from strings.xml that can be overlaid -->
            <!-- String for tether disabling notification title [CHAR LIMIT=200] -->
            <item type="string" name="disable_tether_notification_title"/>
            <!-- String for tether disabling notification message [CHAR LIMIT=200] -->
            <item type="string" name="disable_tether_notification_message"/>
            <!-- String for tether notification channel name [CHAR LIMIT=200] -->
            <item type="string" name="notification_channel_tethering_status"/>
            <!-- Params from strings.xml that can be overlaid -->

            <!-- Params from drawable/ that can be overlaid -->
            <!-- Drawable for enable notification -->
            <item type="drawable" name="stat_sys_tether_hotspot"/>
            <item type="drawable" name="stat_sys_tether_usb"/>
            <item type="drawable" name="stat_sys_tether_bluetooth"/>
            <item type="drawable" name="stat_sys_tether_general"/>
            <!-- Drawable for client number notification -->
            <item type="drawable" name="stat_sys_tether_number_one"/>
            <item type="drawable" name="stat_sys_tether_number_two"/>
            <item type="drawable" name="stat_sys_tether_number_three"/>
            <item type="drawable" name="stat_sys_tether_number_four"/>
            <item type="drawable" name="stat_sys_tether_number_five"/>
            <!-- Drawable for pause notification -->
            <item type="drawable" name="stat_sys_tether_pause_hotspot"/>
            <item type="drawable" name="stat_sys_tether_pause_usb"/>
            <item type="drawable" name="stat_sys_tether_pause_bluetooth"/>
            <item type="drawable" name="stat_sys_tether_pause_general"/>
            <!-- Drawable for upstream roaming notification -->
            <item type="drawable" name="stat_sys_tether_upstream_roaming"/>
            <!-- Params from drawable/ that can be overlaid -->
        </policy>
    </overlayable>
</resources>
