<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <overlayable name="TetheringConfig">
        <policy type="product|system|vendor">
            <!-- Configuration values for TetheringNotificationUpdater -->
            <item type="array" name="tethering_notification_icons"/>
            <item type="string" name="tethering_notification_title_noclients"/>
            <item type="string" name="tethering_notification_text_noclients"/>
            <item type="string" name="tethering_notification_text_power_saving_noclients"/>
            <!-- Add "%2$s" into title or message string if you'd like to show downstream
                 combinations customization.

                 Such as:
                 <string name="tethering_notification_title_noclients">%2$s tethering on</string>
            -->
            <item type="array" name="tethering_downstream_combinations"/>
        </policy>
    </overlayable>
</resources>
