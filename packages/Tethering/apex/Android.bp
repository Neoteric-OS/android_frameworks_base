// Defaults shared between production and test versions of the APEX.
apex_defaults {
    name: "com.android.tethering-defaults",
    updatable: true,
    java_libs: ["framework-tethering"],
    apps: ["Tethering"],
    key: "com.android.tethering.key",
    certificate: ":com.android.tethering.certificate",

    androidManifest: ":com.android.tethering-androidManifest",
}

filegroup {
    name: "com.android.tethering-androidManifest",
    srcs: ["AndroidManifest.xml"],
}

apex {
    name: "com.android.tethering",
    defaults: ["com.android.tethering-defaults"],
    manifest: "manifest.json",
}

apex_key {
    name: "com.android.tethering.key",
    public_key: "com.android.tethering.avbpubkey",
    private_key: "com.android.tethering.pem",
}

android_app_certificate {
    name: "com.android.tethering.certificate",
    certificate: "com.android.tethering",
}
