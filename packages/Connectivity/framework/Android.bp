// TODO: use a java_library in the bootclasspath instead
filegroup {
    name: "framework-connectivity-sources",
    srcs: [
        "src/**/*.java",
        "src/**/*.aidl",
    ],
    path: "src",
    visibility: [
        "//frameworks/base",
        "//packages/modules/Connectivity:__subpackages__",
    ],
}

java_sdk_library {
    name: "framework-connectivity",
    api_only: true,
    // sdk_version: "",
    defaults: ["framework-module-defaults"],
    // default_to_stubs: true,
    platform_apis: true,
    srcs: [
        ":framework-connectivity-sources",
    ],
    aidl: {
        include_dirs: [
            "frameworks/base/core/java", // For framework parcelables
            "frameworks/native/aidl/binder", // For PersistableBundle.aidl
        ],
    },
    impl_only_libs: [
        "framework",
    ],
    libs: [
        "unsupportedappusage",
    ],
    // apex_available: ["com.android.tethering"],
    // installable: true,
    permitted_packages: ["android.net"],
    optimize: {
        enabled: true,
        shrink: true,
    },
    // This library is not launched yet so does not need last api tracking
    unsafe_ignore_missing_latest_api: true,
}

java_library {
    name: "framework-connectivity.impl",
    // Instead of building against private API (framework.jar),
    // build against core_platform + framework-minus-apex + module
    // stub libs. This allows framework.jar to depend on this library,
    // so this library is still part of the private API until all
    // clients have been migrated.
    // TODO: just build against module_api, and remove this jar from
    // the private API.
    sdk_version: "core_platform",
    // platform_apis: true,
    srcs: [
        ":framework-connectivity-sources",
    ],
    aidl: {
        include_dirs: [
            "frameworks/base/core/java", // For framework parcelables
            "frameworks/native/aidl/binder", // For PersistableBundle.aidl
        ],
    },
    libs: [
        "framework-minus-apex",
        "framework-tethering.stubs.module_lib",
        "framework-wifi.stubs.module_lib",
        "unsupportedappusage",
    ],
    apex_available: ["com.android.tethering"],
    installable: true,
    permitted_packages: ["android.net"],
}
