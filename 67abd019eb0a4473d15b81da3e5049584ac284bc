    {
      "key": {
        "uuid": "4f3145f3_94e8f5c7",
        "filename": "telephony/java/android/telephony/CarrierConfigManager.java",
        "patchSetId": 6
      },
      "lineNbr": 2046,
      "author": {
        "id": 1148298
      },
      "writtenOn": "2017-12-11T18:26:11Z",
      "side": 1,
      "message": "This API will return true. No matter the carrier override the values or not, we all treat the bundle as overridden. This new key and API is used to provide the information that \"Carrier has been discovered and carrier config has been applied\", so although the values of the key are the same as the default, but we can still say the \"carrier overridden\" has been applied, right? For example, Tycho can change the values to whatever it needs, no matter those values are different from the default or not, it just needs to know whether its own config bundle has been loaded or not.",
      "parentUuid": "8917139d_cd8c8c82",
      "range": {
        "startLine": 2046,
        "startChar": 65,
        "endLine": 2046,
        "endChar": 86
      },
      "revId": "67abd019eb0a4473d15b81da3e5049584ac284bc",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
