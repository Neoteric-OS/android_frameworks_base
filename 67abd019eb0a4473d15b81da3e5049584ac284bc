        "id": 1060151
      },
      "writtenOn": "2017-12-09T01:17:25Z",
      "side": 1,
      "message": "If the carrier doesn\u0027t override the CC but the SIM is loaded and the CC was chosen with that carrier\u0027s info... would we want the API to return \"true\" or \"false\"? I think \"true\", but that doesn\u0027t mean that the CC was overridden.",
      "range": {
        "startLine": 2046,
        "startChar": 65,
        "endLine": 2046,
        "endChar": 86
      },
      "revId": "67abd019eb0a4473d15b81da3e5049584ac284bc",
