        "id": 1060151
      },
      "writtenOn": "2017-12-09T01:17:25Z",
      "side": 1,
      "message": "As I understand it that\u0027s not going to be the intention of this API. Even if the system doesn\u0027t recognize the carrier... if the CarrierConfig was chosen with information from the UICC, this should return true.",
      "range": {
        "startLine": 2031,
        "startChar": 63,
        "endLine": 2032,
        "endChar": 40
      },
      "revId": "67abd019eb0a4473d15b81da3e5049584ac284bc",
