    {
      "key": {
        "uuid": "1e210fa5_d8327e62",
        "filename": "telephony/java/android/telephony/CarrierConfigManager.java",
        "patchSetId": 6
      },
      "lineNbr": 2038,
      "author": {
        "id": 1060151
      },
      "writtenOn": "2017-12-09T01:17:25Z",
      "side": 1,
      "message": "If you need it to be for the identified carrier, then this API is not sufficient:\n1) carrier A config loads\n2) carrier B config loads \u003c--reloaded\n\nbundle from config A should return true since it was chosen for a specific carrier.",
      "range": {
        "startLine": 2034,
        "startChar": 7,
        "endLine": 2038,
        "endChar": 69
      },
      "revId": "67abd019eb0a4473d15b81da3e5049584ac284bc",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": false
