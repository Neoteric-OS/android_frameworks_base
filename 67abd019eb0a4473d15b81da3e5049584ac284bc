    {
      "key": {
        "uuid": "d739fe5c_8f7ec1d7",
        "filename": "telephony/java/android/telephony/CarrierConfigManager.java",
        "patchSetId": 6
      },
      "lineNbr": 2042,
      "author": {
        "id": 1148298
      },
      "writtenOn": "2017-12-11T18:26:11Z",
      "side": 1,
      "message": "This key only tells whether the platform has successfully got the PLMN from UICC and retrieved the config bundle for it, it can not provide the details for the carrier, we can add the carrier ID for that purpose in the future",
      "parentUuid": "9b9af752_24a6262f",
      "range": {
        "startLine": 2041,
        "startChar": 7,
        "endLine": 2042,
        "endChar": 68
      },
      "revId": "67abd019eb0a4473d15b81da3e5049584ac284bc",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": false
    },
