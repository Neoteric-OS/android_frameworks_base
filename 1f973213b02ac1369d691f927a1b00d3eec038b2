      "writtenOn": "2024-07-18T15:23:59Z",
      "side": 1,
      "message": "Currently, SystemConfig does not provide API interface that could be used from module. Unless we are able to create a new SystemApi, I would not suggest using it.",
      "parentUuid": "0dc84b2d_80515470",
      "revId": "1f973213b02ac1369d691f927a1b00d3eec038b2",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
