      "unresolved": true
    },
    {
      "key": {
        "uuid": "b3bb8ced_c7c069ac",
        "filename": "core/java/android/net/ConnectivityDiagnosticsManager.java",
        "patchSetId": 3
      },
      "lineNbr": 174,
      "author": {
        "id": 1463964
      },
      "writtenOn": "2019-12-19T19:05:38Z",
      "side": 1,
      "message": "Requiring a unique callback is done to avoid reference counting. We could allow callbacks to be registered with multiple network requests, but this would leave the behavior for unregister() ambiguous.\n\nWe will also check for duplicates in ConnectivityService. This is meant only as a preemptive check to speed up the rejection if possible.",
      "parentUuid": "127813a9_e922905c",
      "range": {
        "startLine": 174,
        "startChar": 16,
        "endLine": 174,
        "endChar": 50
      },
