        "id": 1015428
      },
      "writtenOn": "2019-09-27T09:40:13Z",
      "side": 1,
      "message": "Simplified your suggestion to \"Called when a Network no longer satisfied the criteria for this request or callback\" on the assumption that \"no longer\" necessarily means that it used to. See if that works for you.\n\nAs for the clarifications, I took them with very minor edits, as I think they are good. (edits being adding requestDefaultNetworkCallback() where it belongs and downcasing the \"no\").",
      "parentUuid": "53bd5122_ecc23c86",
      "range": {
        "startLine": 3314,
        "startChar": 18,
        "endLine": 3315,
        "endChar": 24
      },
      "revId": "afac33257a1f1794a2a9268f80ed55535029b03e",
