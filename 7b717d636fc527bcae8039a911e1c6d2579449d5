      "writtenOn": "2017-01-27T02:17:43Z",
      "side": 1,
      "message": "This class will only fire off an entitlement check when a sim card is reinserted.  We only transition into this state when we receive CMD_TETHER_MODE_REQUESTED, so I think there\u0027s not cause for concern here.",
      "range": {
        "startLine": 1319,
        "startChar": 16,
        "endLine": 1319,
        "endChar": 44
      },
      "revId": "7b717d636fc527bcae8039a911e1c6d2579449d5",
