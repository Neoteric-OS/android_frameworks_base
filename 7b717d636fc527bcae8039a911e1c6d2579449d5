      },
      "lineNbr": 1319,
      "author": {
        "id": 1000451
      },
      "writtenOn": "2017-01-26T06:52:21Z",
      "side": 1,
      "message": "I think we still need to be listening for SIM changes so we can do entitlement checks.\n\nWhat we decide to do with the results of those checks based on the use case is, of course, a separate matter.",
      "range": {
        "startLine": 1319,
        "startChar": 16,
        "endLine": 1319,
        "endChar": 44
      },
      "revId": "7b717d636fc527bcae8039a911e1c6d2579449d5",
