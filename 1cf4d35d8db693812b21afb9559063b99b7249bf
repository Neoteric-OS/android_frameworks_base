      "lineNbr": 188,
      "author": {
        "id": 1015428
      },
      "writtenOn": "2019-01-22T12:57:01Z",
      "side": 1,
      "message": "I think with the executor we can use the exact same strategy by pushing a Runnable onto the executor instead of sending a message to the handler. (that means the executor has to be stored in a member, but so be it).",
      "parentUuid": "7f620f65_e9e9ad5b",
      "range": {
        "startLine": 188,
        "startChar": 16,
        "endLine": 188,
        "endChar": 29
      },
      "revId": "1cf4d35d8db693812b21afb9559063b99b7249bf",
